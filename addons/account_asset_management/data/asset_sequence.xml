    Asset Sequence - Unique Reference Generation (AM-001 AC4)

    Generates unique asset reference numbers in the format FA/YYYY/NNNN
    (e.g., FA/2025/0001) for every new account.asset record.  This sequence
    is wrapped in <data noupdate="1"> to preserve any administrator
    customization (prefix, padding, starting number) across upgrades.
-->
<odoo>
    <data noupdate="1">
        <record id="sequence_account_asset" model="ir.sequence">
            <field name="name">Asset Reference</field>
            <field name="code">account.asset</field>
            <field name="prefix">FA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
            <field name="use_date_range" eval="True"/>
        </record>
    </data>
</odoo>
