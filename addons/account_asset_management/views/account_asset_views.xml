    FEATURE-004 Asset Management - Core Asset Views (AM-001, AM-002, AM-003)

    Backs the following user stories:
      AM-001: Asset Registration (name, reference, acquisition, accounts,
              vendor/invoice linkage, category inheritance, draft state)
      AM-002: Depreciation Configuration (method, useful life, salvage
              value, declining factor, switch-to-straight-line, units of
              production, start date option)
      AM-003: Depreciation Board (embedded tree on form notebook with
              posted/draft/skipped state decorations; read-only - the
              schedule is system-generated by _compute_depreciation_schedule)

    View types: list, form (with chatter), kanban, search.
    Window action: action_account_asset with state decorations and help HTML.

    AAP Rule Compliance
    ===================
    * R-01 (Module independence) - No references to sibling CE modules
      (account_budget_management, account_deferred_revenue,
      account_payment_followup). Only references this module's models
      (account.asset, account.asset.category, account.asset.depreciation.line)
      and core Odoo models (account.move, account.account, account.journal,
      res.partner, res.company, res.currency, mail.thread).
    * R-02 (No Enterprise deps) - No references to Enterprise modules.
    * R-05 (No core view modification) - All records are NET-NEW views on
      account.asset (a NET-NEW model). No inherit_id attributes anywhere.
    * R-07 (No sudo) - Not applicable (XML only).
    * R-09 (Exact module folder name) - File lives in
      addons/account_asset_management/views/ as required.
-->
<odoo>

    <!-- ==================================================================
         LIST VIEW
         Supports AM-001 AC1 (asset registration entry point), AM-003
         (at-a-glance NBV / cumulative depreciation across all assets).
         State decorations match the asset lifecycle: draft=info (blue),
         open=success (green), close=muted (grey). multi_edit allows
         batch updates to category/vendor across selected assets.
         ================================================================== -->
    <record id="view_account_asset_list" model="ir.ui.view">
        <field name="name">account.asset.list</field>
        <field name="model">account.asset</field>
        <field name="arch" type="xml">
            <list string="Fixed Assets"
                  default_order="acquisition_date desc, reference"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'open'"
                  decoration-muted="state == 'close'"
                  multi_edit="1">
                <field name="reference"/>
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="acquisition_date"/>
                <field name="acquisition_cost" sum="Total Acquisition Cost"/>
                <field name="accumulated_depreciation"
                       sum="Total Accumulated Depreciation"
                       optional="hide"/>
                <field name="net_book_value" sum="Total NBV"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'open'"
                       decoration-muted="state == 'close'"/>
                <field name="vendor_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ==================================================================
         FORM VIEW
         The central UX surface for AM-001 (registration), AM-002 (method
         config), and AM-003 (embedded depreciation board). Three tabs:
             1. General:          accounts, vendor, source invoice
             2. Depreciation:     method + useful life + start date
             3. Depreciation Board: embedded read-only schedule tree

         Draft state allows all edits; open state locks configuration
         (use action_modify wizard for changes); close state is fully
         read-only including the depreciation board.
         ================================================================== -->
    <record id="view_account_asset_form" model="ir.ui.view">
        <field name="name">account.asset.form</field>
        <field name="model">account.asset</field>
        <field name="arch" type="xml">
            <form string="Fixed Asset">
                <!-- HEADER: lifecycle action buttons + statusbar -->
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            help="Confirm the asset registration. This creates the acquisition journal entry and generates the depreciation schedule."/>
                    <button name="action_dispose"
                            string="Dispose"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'open'"
                            help="Open the disposal wizard (sale, scrap, or write-off)."/>
                    <button name="action_modify"
                            string="Modify"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'open'"
                            help="Open the modification wizard (revaluation, impairment, useful life change)."/>
                    <button name="action_set_draft"
                            string="Set to Draft"
                            type="object"
                            groups="account.group_account_manager"
                            confirm="Reverting this asset to draft will cancel the acquisition journal entry. Continue?"
                            invisible="state == 'draft'"
                            help="Administrator-only: revert to draft state for corrections. Reverses the acquisition entry."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,close"/>
                </header>
                <sheet>
                    <!-- Smart buttons: navigation to related records -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_view_depreciation_lines"
                                icon="fa-list-alt"
                                invisible="depreciation_line_count == 0">
                            <field name="depreciation_line_count"
                                   widget="statinfo"
                                   string="Depreciation Lines"/>
                        </button>
                    </div>

                    <!-- Archived banner: visible only when active=False -->
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>

                    <!-- Title: asset name (h1) + auto-generated reference (h2) -->
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g., Office Building HQ, Production Line #3..."/>
                        </h1>
                        <label for="reference" class="oe_edit_only"/>
                        <h2>
                            <field name="reference"
                                   placeholder="(auto-generated from sequence)"
                                   readonly="state != 'draft'"/>
                        </h2>
                    </div>

                    <!-- Primary two-column group: Acquisition + Status Summary -->
                    <group>
                        <group name="acquisition" string="Acquisition">
                            <field name="category_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="acquisition_date"
                                   readonly="state != 'draft'"/>
                            <field name="acquisition_cost"
                                   readonly="state != 'draft'"/>
                            <field name="salvage_value"
                                   readonly="state != 'draft'"/>
                            <field name="active" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group name="status" string="Status Summary">
                            <field name="accumulated_depreciation"/>
                            <field name="net_book_value"
                                   class="oe_subtotal_footer_separator"/>
                            <field name="acquisition_move_id"
                                   readonly="1"
                                   invisible="not acquisition_move_id"
                                   options="{'no_create': True, 'no_open': False}"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- NOTEBOOK: 3 tabs -->
                    <notebook>
                        <!-- TAB 1: General (AM-001 AC5/AC6 - accounts, vendor, source invoice) -->
                        <page name="general" string="General">
                            <group>
                                <group name="accounts" string="Accounts">
                                    <field name="asset_account_id"
                                           readonly="state != 'draft'"
                                           options="{'no_create': True}"/>
                                    <field name="expense_account_id"
                                           readonly="state != 'draft'"
                                           options="{'no_create': True}"/>
                                    <field name="accumulated_depreciation_account_id"
                                           readonly="state != 'draft'"
                                           options="{'no_create': True}"/>
                                    <field name="journal_id"
                                           readonly="state != 'draft'"
                                           options="{'no_create': True}"/>
                                </group>
                                <group name="vendor_invoice" string="Vendor &amp; Source Invoice">
                                    <field name="vendor_id"
                                           readonly="state != 'draft'"
                                           options="{'no_create': True}"/>
                                    <field name="source_invoice_id"
                                           readonly="state != 'draft'"
                                           options="{'no_create': True, 'no_open': False}"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 2: Depreciation (AM-002 configuration) -->
                        <page name="depreciation" string="Depreciation">
                            <group>
                                <group name="depreciation_method" string="Method">
                                    <field name="depreciation_method"
                                           readonly="state != 'draft'"/>
                                    <field name="useful_life_unit"
                                           readonly="state != 'draft'"
                                           invisible="depreciation_method == 'units_of_production'"/>
                                    <field name="useful_life_years"
                                           readonly="state != 'draft'"
                                           invisible="useful_life_unit != 'years' or depreciation_method == 'units_of_production'"
                                           required="useful_life_unit == 'years' and depreciation_method in ('straight_line', 'declining_balance')"/>
                                    <field name="useful_life_months"
                                           readonly="state != 'draft'"
                                           invisible="useful_life_unit != 'months' or depreciation_method == 'units_of_production'"
                                           required="useful_life_unit == 'months' and depreciation_method in ('straight_line', 'declining_balance')"/>
                                    <field name="declining_factor"
                                           readonly="state != 'draft'"
                                           invisible="depreciation_method != 'declining_balance'"
                                           required="depreciation_method == 'declining_balance'"/>
                                    <field name="switch_to_straight_line"
                                           readonly="state != 'draft'"
                                           invisible="depreciation_method != 'declining_balance'"/>
                                    <field name="units_production_total"
                                           readonly="state != 'draft'"
                                           invisible="depreciation_method != 'units_of_production'"
                                           required="depreciation_method == 'units_of_production'"/>
                                    <field name="units_production_to_date"
                                           invisible="depreciation_method != 'units_of_production'"/>
                                </group>
                                <group name="depreciation_start" string="Start Date">
                                    <field name="start_date_option"
                                           readonly="state != 'draft'"/>
                                    <field name="depreciation_start_date"
                                           readonly="state != 'draft' or start_date_option != 'manual'"
                                           required="start_date_option == 'manual'"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 3: Depreciation Board (AM-003 - embedded read-only schedule) -->
                        <page name="depreciation_board" string="Depreciation Board">
                            <field name="depreciation_line_ids"
                                   readonly="state == 'close'"
                                   context="{'default_asset_id': id}">
                                <list string="Depreciation Schedule"
                                      default_order="sequence, depreciation_date"
                                      decoration-success="state == 'posted'"
                                      decoration-muted="state == 'skipped'"
                                      decoration-info="state == 'draft'"
                                      create="false"
                                      delete="false"
                                      limit="80">
                                    <field name="sequence" string="Period"/>
                                    <field name="depreciation_date"/>
                                    <field name="depreciation_amount" sum="Total"/>
                                    <field name="cumulative_depreciation"/>
                                    <field name="net_book_value"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'posted'"
                                           decoration-muted="state == 'skipped'"
                                           decoration-info="state == 'draft'"/>
                                    <field name="move_id" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <!-- CHATTER: mail.thread + mail.activity.mixin shortcut tag
                     (Odoo 17+ convention replacing <div class="oe_chatter">) -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================================================================
         KANBAN VIEW
         Grouped by state for pipeline-style visualization. Useful for
         accountants reviewing draft assets awaiting confirmation vs
         running assets under depreciation vs closed/disposed assets.

         Uses the Odoo 19 ``<t t-name="card">`` template standard.
         The legacy ``<t t-name="kanban-box">`` pattern (Odoo <=17)
         has been superseded and triggers an OwlError "Missing 'card'
         template" if used in 19.0.
         ================================================================== -->
    <record id="view_account_asset_kanban" model="ir.ui.view">
        <field name="name">account.asset.kanban</field>
        <field name="model">account.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    class="o_kanban_small_column"
                    sample="1">
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="reference"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <span class="text-muted">Category:</span>
                                    <field name="category_id"/>
                                </div>
                                <div>
                                    <span class="text-muted">Acquired:</span>
                                    <field name="acquisition_date"/>
                                </div>
                                <div>
                                    <span class="text-muted">Cost:</span>
                                    <field name="acquisition_cost" widget="monetary"/>
                                </div>
                                <div>
                                    <span class="text-muted">NBV:</span>
                                    <field name="net_book_value" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================================================================
         SEARCH VIEW
         Top-level searchable fields (reference, name, category, vendor,
         source invoice), three groups of filters (state / method /
         archived), and a group-by toolbox with state, category, method,
         vendor, acquisition date (month + year), and company for
         multi-company installations.
         ================================================================== -->
    <record id="view_account_asset_search" model="ir.ui.view">
        <field name="name">account.asset.search</field>
        <field name="model">account.asset</field>
        <field name="arch" type="xml">
            <search string="Fixed Assets">
                <field name="reference"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="vendor_id"/>
                <field name="source_invoice_id"/>

                <!-- State filters -->
                <separator/>
                <filter name="filter_draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_open"
                        string="Running"
                        domain="[('state', '=', 'open')]"/>
                <filter name="filter_close"
                        string="Closed"
                        domain="[('state', '=', 'close')]"/>

                <!-- Method filters -->
                <separator/>
                <filter name="filter_straight_line"
                        string="Straight-Line"
                        domain="[('depreciation_method', '=', 'straight_line')]"/>
                <filter name="filter_declining_balance"
                        string="Declining Balance"
                        domain="[('depreciation_method', '=', 'declining_balance')]"/>
                <filter name="filter_units_of_production"
                        string="Units of Production"
                        domain="[('depreciation_method', '=', 'units_of_production')]"/>

                <!-- Archived filter -->
                <separator/>
                <filter name="filter_archived"
                        string="Archived"
                        domain="[('active', '=', False)]"/>

                <!-- Group-by toolbox -->
                <separator/>
                <group>
                    <filter name="groupby_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="groupby_category"
                            string="Category"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="groupby_method"
                            string="Depreciation Method"
                            context="{'group_by': 'depreciation_method'}"/>
                    <filter name="groupby_vendor"
                            string="Vendor"
                            context="{'group_by': 'vendor_id'}"/>
                    <filter name="groupby_acq_date_month"
                            string="Acquisition Month"
                            context="{'group_by': 'acquisition_date:month'}"/>
                    <filter name="groupby_acq_date_year"
                            string="Acquisition Year"
                            context="{'group_by': 'acquisition_date:year'}"/>
                    <filter name="groupby_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================================================================
         WINDOW ACTION
         Entry point to the asset register. Defaults new assets to draft
         and filters the initial list to running (open) assets so the
         user immediately sees the active asset pool rather than archival
         records. Users can clear the filter to see all states.
         ================================================================== -->
    <record id="action_account_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">account.asset</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_account_asset_search"/>
        <field name="context">{'default_state': 'draft', 'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new fixed asset
            </p>
            <p>
                Track capital assets (buildings, vehicles, equipment, IT hardware) through
                their full lifecycle: acquisition, depreciation, revaluation, impairment,
                and disposal.
            </p>
            <p>
                Once confirmed, the system will automatically generate the depreciation
                schedule based on the configured method (straight-line, declining balance,
                or units of production) and post depreciation journal entries daily
                through the Scheduled Action.
            </p>
        </field>
    </record>

</odoo>
