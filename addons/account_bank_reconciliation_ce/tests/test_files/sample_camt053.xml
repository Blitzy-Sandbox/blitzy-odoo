<?xml version="1.0" encoding="UTF-8"?>
<!--
    Sample ISO 20022 CAMT.053.001.02 Bank-to-Customer Statement
    ============================================================
    This file is a test fixture for the account_bank_reconciliation_ce module.
    It provides a valid CAMT.053 XML document used to verify:
      - CAMT.053 namespace-based format auto-detection via lxml.etree
      - XML element parsing for statement header, account, balances, and entries
      - CRDT/DBIT indicator handling (ISO 20022 convention, not signed amounts)
      - Structured reference extraction (EndToEndId, AcctSvcrRef)
      - Unstructured remittance information parsing (Ustrd)
      - Related party name extraction (Dbtr/Cdtr) for partner matching
      - Opening (OPBD) and closing (CLBD) balance validation
      - Balance equation: OPBD + credits - debits = CLBD
        (5000.00 + 3500.00 - 675.00 = 7825.00)

    Transactions are consistent with other sample files (sample.csv, sample.ofx,
    sample.qif) to enable cross-format validation in the test suite.

    License AGPL-3.0 or later (https://www.gnu.org/licenses/agpl).
-->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:camt.053.001.02"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="urn:iso:std:iso:20022:tech:xsd:camt.053.001.02 camt.053.001.02.xsd">
    <BkToCstmrStmt>
        <!-- ============================================================ -->
        <!-- Group Header                                                  -->
        <!-- ============================================================ -->
        <GrpHdr>
            <MsgId>STMT20240119001</MsgId>
            <CreDtTm>2024-01-19T18:00:00</CreDtTm>
        </GrpHdr>

        <!-- ============================================================ -->
        <!-- Statement                                                     -->
        <!-- ============================================================ -->
        <Stmt>
            <Id>STMT001</Id>
            <ElctrncSeqNb>1</ElctrncSeqNb>
            <LglSeqNb>1</LglSeqNb>
            <CreDtTm>2024-01-19T18:00:00</CreDtTm>

            <!-- ======================================================== -->
            <!-- Account Identification                                    -->
            <!-- ======================================================== -->
            <Acct>
                <Id>
                    <IBAN>DE89370400440532013000</IBAN>
                </Id>
                <Ccy>USD</Ccy>
                <Ownr>
                    <Nm>Test Company</Nm>
                </Ownr>
                <Svcr>
                    <FinInstnId>
                        <BIC>COBADEFFXXX</BIC>
                    </FinInstnId>
                </Svcr>
            </Acct>

            <!-- ======================================================== -->
            <!-- Opening Balance (OPBD)                                    -->
            <!-- 5000.00 USD Credit as of 2024-01-14                       -->
            <!-- ======================================================== -->
            <Bal>
                <Tp>
                    <CdOrPrtry>
                        <Cd>OPBD</Cd>
                    </CdOrPrtry>
                </Tp>
                <Amt Ccy="USD">5000.00</Amt>
                <CdtDbtInd>CRDT</CdtDbtInd>
                <Dt>
                    <Dt>2024-01-14</Dt>
                </Dt>
            </Bal>

            <!-- ======================================================== -->
            <!-- Entry 1: Incoming payment (Credit)                        -->
            <!-- Amount: 1000.00 USD | Date: 2024-01-15                    -->
            <!-- Reference: INV/2024/001 | Partner: Reconciliation Test    -->
            <!-- ======================================================== -->
            <Ntry>
                <Amt Ccy="USD">1000.00</Amt>
                <CdtDbtInd>CRDT</CdtDbtInd>
                <Sts>BOOK</Sts>
                <BookgDt>
                    <Dt>2024-01-15</Dt>
                </BookgDt>
                <ValDt>
                    <Dt>2024-01-15</Dt>
                </ValDt>
                <AcctSvcrRef>TXN20240115001</AcctSvcrRef>
                <NtryDtls>
                    <TxDtls>
                        <Refs>
                            <EndToEndId>INV/2024/001</EndToEndId>
                        </Refs>
                        <RltdPties>
                            <Dbtr>
                                <Nm>Reconciliation Test Partner</Nm>
                            </Dbtr>
                        </RltdPties>
                        <RmtInf>
                            <Ustrd>Payment INV/2024/001</Ustrd>
                        </RmtInf>
                    </TxDtls>
                </NtryDtls>
            </Ntry>

            <!-- ======================================================== -->
            <!-- Entry 2: Supplier payment (Debit)                         -->
            <!-- Amount: 500.00 USD | Date: 2024-01-16                     -->
            <!-- Reference: SUPPLIER/2024/001 | Partner: Test Supplier Ltd -->
            <!-- ======================================================== -->
            <Ntry>
                <Amt Ccy="USD">500.00</Amt>
                <CdtDbtInd>DBIT</CdtDbtInd>
                <Sts>BOOK</Sts>
                <BookgDt>
                    <Dt>2024-01-16</Dt>
                </BookgDt>
                <ValDt>
                    <Dt>2024-01-16</Dt>
                </ValDt>
                <AcctSvcrRef>TXN20240116001</AcctSvcrRef>
                <NtryDtls>
                    <TxDtls>
                        <Refs>
                            <EndToEndId>SUPPLIER/2024/001</EndToEndId>
                        </Refs>
                        <RltdPties>
                            <Cdtr>
                                <Nm>Test Supplier Ltd</Nm>
                            </Cdtr>
                        </RltdPties>
                        <RmtInf>
                            <Ustrd>Supplier Payment</Ustrd>
                        </RmtInf>
                    </TxDtls>
                </NtryDtls>
            </Ntry>

            <!-- ======================================================== -->
            <!-- Entry 3: Bank service fee (Debit)                         -->
            <!-- Amount: 25.00 USD | Date: 2024-01-17                      -->
            <!-- Reference: FEE20240117001 | No related party              -->
            <!-- ======================================================== -->
            <Ntry>
                <Amt Ccy="USD">25.00</Amt>
                <CdtDbtInd>DBIT</CdtDbtInd>
                <Sts>BOOK</Sts>
                <BookgDt>
                    <Dt>2024-01-17</Dt>
                </BookgDt>
                <ValDt>
                    <Dt>2024-01-17</Dt>
                </ValDt>
                <AcctSvcrRef>TXN20240117001</AcctSvcrRef>
                <NtryDtls>
                    <TxDtls>
                        <Refs>
                            <EndToEndId>FEE20240117001</EndToEndId>
                        </Refs>
                        <RmtInf>
                            <Ustrd>Bank Service Fee</Ustrd>
                        </RmtInf>
                    </TxDtls>
                </NtryDtls>
            </Ntry>

            <!-- ======================================================== -->
            <!-- Entry 4: Customer refund (Debit)                          -->
            <!-- Amount: 150.00 USD | Date: 2024-01-18                     -->
            <!-- Reference: REF003 | Partner: Reconciliation Test Partner  -->
            <!-- ======================================================== -->
            <Ntry>
                <Amt Ccy="USD">150.00</Amt>
                <CdtDbtInd>DBIT</CdtDbtInd>
                <Sts>BOOK</Sts>
                <BookgDt>
                    <Dt>2024-01-18</Dt>
                </BookgDt>
                <ValDt>
                    <Dt>2024-01-18</Dt>
                </ValDt>
                <AcctSvcrRef>TXN20240118001</AcctSvcrRef>
                <NtryDtls>
                    <TxDtls>
                        <Refs>
                            <EndToEndId>REF003</EndToEndId>
                        </Refs>
                        <RltdPties>
                            <Cdtr>
                                <Nm>Reconciliation Test Partner</Nm>
                            </Cdtr>
                        </RltdPties>
                        <RmtInf>
                            <Ustrd>Customer Refund</Ustrd>
                        </RmtInf>
                    </TxDtls>
                </NtryDtls>
            </Ntry>

            <!-- ======================================================== -->
            <!-- Entry 5: Wire transfer in (Credit)                        -->
            <!-- Amount: 2500.00 USD | Date: 2024-01-19                    -->
            <!-- Reference: WIRE001 | Partner: International Corp          -->
            <!-- ======================================================== -->
            <Ntry>
                <Amt Ccy="USD">2500.00</Amt>
                <CdtDbtInd>CRDT</CdtDbtInd>
                <Sts>BOOK</Sts>
                <BookgDt>
                    <Dt>2024-01-19</Dt>
                </BookgDt>
                <ValDt>
                    <Dt>2024-01-19</Dt>
                </ValDt>
                <AcctSvcrRef>TXN20240119001</AcctSvcrRef>
                <NtryDtls>
                    <TxDtls>
                        <Refs>
                            <EndToEndId>WIRE001</EndToEndId>
                        </Refs>
                        <RltdPties>
                            <Dbtr>
                                <Nm>International Corp</Nm>
                            </Dbtr>
                        </RltdPties>
                        <RmtInf>
                            <Ustrd>Wire Transfer In</Ustrd>
                        </RmtInf>
                    </TxDtls>
                </NtryDtls>
            </Ntry>

            <!-- ======================================================== -->
            <!-- Closing Balance (CLBD)                                    -->
            <!-- 7825.00 USD Credit as of 2024-01-19                       -->
            <!-- Equation: 5000 + 1000 - 500 - 25 - 150 + 2500 = 7825     -->
            <!-- ======================================================== -->
            <Bal>
                <Tp>
                    <CdOrPrtry>
                        <Cd>CLBD</Cd>
                    </CdOrPrtry>
                </Tp>
                <Amt Ccy="USD">7825.00</Amt>
                <CdtDbtInd>CRDT</CdtDbtInd>
                <Dt>
                    <Dt>2024-01-19</Dt>
                </Dt>
            </Bal>
        </Stmt>
    </BkToCstmrStmt>
</Document>
