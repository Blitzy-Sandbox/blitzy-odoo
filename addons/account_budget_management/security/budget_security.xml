<odoo>

    <!--
        ==================================================================
        Module Category
        ==================================================================
        Defined OUTSIDE <data noupdate="1"> so that category metadata
        (including any future sequence or description changes) propagates
        on upgrade. Provides a dedicated "Budget Management" category in
        Settings -> Users -> Access Rights for clean group organization.

        Precedent: addons/account_deferred_revenue/security/deferred_security.xml
        uses the same pattern for the "Deferred Revenue" category.
    -->
    <record id="module_category_budget_management" model="ir.module.category">
        <field name="name">Budget Management</field>
        <field name="description">Manage budgets, period allocations, variance analysis, and threshold alerts.</field>
        <field name="sequence">25</field>
    </record>

    <!--
        ==================================================================
        Groups Privilege
        ==================================================================
        In Odoo 19, res.groups no longer holds category_id directly;
        instead, a res.groups.privilege record carries the category_id
        and is referenced from res.groups via privilege_id.  This matches
        the pattern established by addons/account/security/account_security.xml
        (res_groups_privilege_accounting).  Defined OUTSIDE <data noupdate="1">
        so that category-propagation metadata re-applies on upgrade.
    -->
    <record id="res_groups_privilege_budget_management" model="res.groups.privilege">
        <field name="name">Budget Management</field>
        <field name="category_id" ref="module_category_budget_management"/>
        <field name="sequence">25</field>
    </record>

    <!--
        ==================================================================
        Groups
        ==================================================================
        Defined OUTSIDE <data noupdate="1"> so that implied_ids
        relationships re-apply on every module upgrade. If an administrator
        customizes the group, their changes to implied_ids would otherwise
        be preserved at the cost of losing new implications added by later
        module versions - that is not the correct trade-off for a security
        group defining module capabilities.

        Note: Custom module-specific groups are defined to allow granular
        control for future extensions. Current ACL rows in
        ``ir.model.access.csv`` still reference the core
        ``account.group_account_user`` / ``account.group_account_manager``
        groups directly (the OCA precedent from FEATURE-001/002), but the
        reverse-implication records below ensure every member of the core
        accounting groups transparently receives the budget-specific
        groups as well.
    -->

    <!-- User Group: read/write/create on budgets; cannot unlink alerts. -->
    <record id="group_budget_user" model="res.groups">
        <field name="name">User: Own Budgets</field>
        <field name="privilege_id" ref="res_groups_privilege_budget_management"/>
        <field name="implied_ids" eval="[Command.link(ref('account.group_account_user'))]"/>
    </record>

    <!-- Manager Group: full CRUD; can unlink budgets (but not alerts: BM-005 audit trail). -->
    <record id="group_budget_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_budget_management"/>
        <field name="implied_ids" eval="[Command.link(ref('group_budget_user')), Command.link(ref('account.group_account_manager'))]"/>
    </record>

    <!--
        ==================================================================
        Reverse-implication: extend existing account groups
        ==================================================================
        Every user holding `account.group_account_user` automatically gets
        `group_budget_user`. Every user holding
        `account.group_account_manager` automatically gets
        `group_budget_manager`. This is the CE UX pattern:
        installing this module transparently grants budget management
        access to every existing accountant, without requiring an admin
        to manually add users to new groups.

        Uses Command.link (NOT Command.set / tuple (6,0,[...])) to APPEND
        to the existing implied_ids list without clobbering prior
        implications added by other addons (e.g., FEATURE-001, FEATURE-002,
        or sibling new modules in Tracks A/C/D).
    -->
    <record id="account.group_account_user" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_budget_user'))]"/>
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_budget_manager'))]"/>
    </record>

    <!--
        ==================================================================
        Record Rules
        ==================================================================
        Defined INSIDE <data noupdate="1"> so that administrators can
        customize the multi-company domain (e.g., to add branch-level
        filtering) without their customizations being wiped on each
        module upgrade. This matches the Odoo core pattern for ir.rule.

        All four net-new models expose a ``company_id`` field — either
        as a direct storage field (``budget.budget``) or as a stored
        ``related=`` field inherited from the parent line / budget
        (``budget.budget.line``, ``budget.budget.period``,
        ``budget.alert``). The same domain form
        ``['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]``
        therefore applies uniformly across all four rules.
    -->
    <data noupdate="1">

        <!-- Multi-company rule: budget headers visible only for the user's allowed companies. -->
        <record id="budget_budget_multi_company_rule" model="ir.rule">
            <field name="name">Budget: Multi-Company</field>
            <field name="model_id" ref="model_budget_budget"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Multi-company rule: budget lines follow their parent budget's company (stored related). -->
        <record id="budget_budget_line_multi_company_rule" model="ir.rule">
            <field name="name">Budget Line: Multi-Company</field>
            <field name="model_id" ref="model_budget_budget_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Multi-company rule: budget periods follow their parent line's company (stored related). -->
        <record id="budget_budget_period_multi_company_rule" model="ir.rule">
            <field name="name">Budget Period: Multi-Company</field>
            <field name="model_id" ref="model_budget_budget_period"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Multi-company rule: budget alerts follow their parent line's company (stored related). -->
        <record id="budget_alert_multi_company_rule" model="ir.rule">
            <field name="name">Budget Alert: Multi-Company</field>
            <field name="model_id" ref="model_budget_alert"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>

</odoo>
