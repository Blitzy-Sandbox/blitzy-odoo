<odoo>
    <!--
        BM-002 — Budget Period Allocation Views

        Standalone views for ``budget.budget.period`` records. The inline
        period list rendered inside a ``budget.budget.line`` form is defined
        in ``budget_views.xml``; the records below provide a complementary
        cross-budget list + form + search surface referenced from
        ``menuitem.xml`` (``action_budget_period``) for auditors and
        managers who want a flat view of every period across all budgets.

        Model alignment: the view references only fields that actually
        exist on ``budget.budget.period`` (see ``models/budget_period.py``):
        ``budget_line_id``, ``budget_id``, ``account_id``, ``company_id``,
        ``currency_id``, ``sequence``, ``period_type``, ``date_from``,
        ``date_to``, ``allocated_amount``, ``allocation_percentage``,
        ``name``, ``state``, ``audit_note``. The model also inherits
        ``mail.thread`` — the form below includes a chatter element so
        tracked modifications on ``allocated_amount`` / ``audit_note`` /
        ``period_type`` surface alongside the free-form audit note,
        satisfying BM-002 Scenario 5 (audit trail preservation).

        Rules compliance:
          * R-01 — no references to sibling new modules' XML IDs.
          * R-02 — no Enterprise module references.
          * R-05 — renders only ``budget.budget.period`` fields.
          * R-08 — no ``variance_*`` / ``alert_*`` / ``budget.alert`` /
                   ``budget.variance.wizard`` references.
          * R-09 — exact path
                   ``addons/account_budget_management/views/budget_period_views.xml``.
    -->

    <!-- ================================================================
         Form view — budget.budget.period
         ================================================================ -->
    <record id="view_budget_period_form" model="ir.ui.view">
        <field name="name">budget.budget.period.form</field>
        <field name="model">budget.budget.period</field>
        <field name="arch" type="xml">
            <form string="Budget Period">
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,closed"
                           readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="scope" string="Scope">
                            <field name="budget_line_id"
                                   options="{'no_create': True}"/>
                            <field name="budget_id" readonly="1"/>
                            <field name="account_id" readonly="1"/>
                            <field name="sequence"/>
                        </group>
                        <group name="period" string="Period">
                            <field name="period_type" widget="radio"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="name" readonly="1"/>
                        </group>
                    </group>
                    <group string="Allocation">
                        <group name="allocation_left">
                            <field name="allocated_amount" widget="monetary"/>
                            <!--
                                ``allocation_percentage`` is stored in
                                0-100 form (CHECK constraint enforces
                                0..100 in budget_period.py). Standard
                                Odoo ``widget="percentage"`` MULTIPLIES
                                the underlying value by 100 for display
                                (see addons/web/static/src/views/fields/
                                formatters.js ``formatPercentage``), so
                                applying the widget to a 0-100 field
                                would render e.g. 50.00 as "5000%".
                                Plain Float display with
                                ``digits=(7,4)`` produces a clean
                                "50.0000" presentation that the field's
                                ``string`` annotates as "Allocation
                                Share (%)".
                            -->
                            <field name="allocation_percentage"
                                   readonly="1"/>
                        </group>
                        <group name="allocation_right">
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Audit Trail" name="audit">
                            <group>
                                <field name="audit_note"
                                       nolabel="1"
                                       placeholder="Reason for modification (required when amount changes on a confirmed budget)..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================
         List view — budget.budget.period
         ================================================================ -->
    <record id="view_budget_period_tree" model="ir.ui.view">
        <field name="name">budget.budget.period.tree</field>
        <field name="model">budget.budget.period</field>
        <field name="arch" type="xml">
            <list string="Budget Periods"
                  sample="1"
                  default_order="budget_id, date_from, sequence"
                  editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="budget_id"
                       options="{'no_create': True}"
                       readonly="1"/>
                <field name="budget_line_id"
                       options="{'no_create': True}"/>
                <field name="account_id"
                       readonly="1"
                       optional="show"/>
                <field name="period_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="allocated_amount"
                       widget="monetary"
                       sum="Total Allocated"/>
                <!--
                    ``allocation_percentage`` stored in 0-100 form;
                    plain Float display avoids the
                    ``widget="percentage"`` 100× multiplication (see
                    related comment on the form view above). Field
                    ``string`` is "Allocation Share (%)".
                -->
                <field name="allocation_percentage"
                       optional="hide"/>
                <field name="state" optional="show"/>
                <field name="audit_note" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         Search view — budget.budget.period
         ================================================================ -->
    <record id="view_budget_period_search" model="ir.ui.view">
        <field name="name">budget.budget.period.search</field>
        <field name="model">budget.budget.period</field>
        <field name="arch" type="xml">
            <search string="Search Budget Periods">
                <field name="budget_id"/>
                <field name="budget_line_id"/>
                <field name="account_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <separator/>
                <filter string="Monthly"
                        name="period_monthly"
                        domain="[('period_type', '=', 'monthly')]"/>
                <filter string="Quarterly"
                        name="period_quarterly"
                        domain="[('period_type', '=', 'quarterly')]"/>
                <filter string="Annual"
                        name="period_annual"
                        domain="[('period_type', '=', 'annual')]"/>
                <filter string="Custom"
                        name="period_custom"
                        domain="[('period_type', '=', 'custom')]"/>
                <separator/>
                <filter string="Draft"
                        name="state_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed"
                        name="state_confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Closed"
                        name="state_closed"
                        domain="[('state', '=', 'closed')]"/>
                <filter string="Cancelled"
                        name="state_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Current Period"
                        name="current_period"
                        domain="[('date_from', '&lt;=', context_today()), ('date_to', '&gt;=', context_today())]"/>
                <filter string="Has Audit Note"
                        name="has_audit_note"
                        domain="[('audit_note', '!=', False)]"/>
                <group>
                    <filter string="Budget"
                            name="group_budget"
                            domain="[]"
                            context="{'group_by': 'budget_id'}"/>
                    <filter string="Budget Line"
                            name="group_line"
                            domain="[]"
                            context="{'group_by': 'budget_line_id'}"/>
                    <filter string="Account"
                            name="group_account"
                            domain="[]"
                            context="{'group_by': 'account_id'}"/>
                    <filter string="Period Type"
                            name="group_period_type"
                            domain="[]"
                            context="{'group_by': 'period_type'}"/>
                    <filter string="Status"
                            name="group_state"
                            domain="[]"
                            context="{'group_by': 'state'}"/>
                    <filter string="Start Date"
                            name="group_date_from"
                            domain="[]"
                            context="{'group_by': 'date_from'}"/>
                    <filter string="Company"
                            name="group_company"
                            domain="[]"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         Window action — budget.budget.period
         ================================================================ -->
    <record id="action_budget_period" model="ir.actions.act_window">
        <field name="name">Budget Periods</field>
        <field name="res_model">budget.budget.period</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_budget_period_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No periods allocated yet
            </p>
            <p>
                Budget periods are created from a Budget Line (open a Budget,
                drill down to a line, and use the Period Allocation tab). This
                page provides a flat, cross-budget view for audit and reporting.
            </p>
        </field>
    </record>

</odoo>
