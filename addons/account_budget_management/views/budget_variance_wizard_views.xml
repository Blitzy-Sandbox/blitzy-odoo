<odoo>

    <!--
    ====================================================================
    BM-004 Variance Analysis Wizard Views
    ====================================================================

    Story:  tickets/stories/budget-management/BM-004-variance-analysis.md
    Model:  wizard/budget_variance_wizard.py :: ``BudgetVarianceWizard``
            (``budget.variance.wizard``)

    This file registers:

      * view_budget_variance_wizard_form : the wizard form,
        organized as Filter Inputs (top) + Variance Summary (bottom).
      * action_budget_variance_wizard    : the menu-entry action
        opening the wizard in dialog target mode.

    The menu entry for this action is defined in
    ``views/menuitem.xml`` (ordered LAST among view files so that
    this action is already loaded).

    Rules compliance:
      * R-01 Module independence: this XML file references only
        ``budget.variance.wizard`` (from this module) and models from
        ``account`` / ``analytic`` (both declared in manifest
        ``depends``).
      * R-02 No Enterprise: no Enterprise module references.
      * R-08 Field partitioning: the wizard's ``variance_*`` output
        fields are read-only summary surfaces displayed alongside the
        neutrally-named filter input fields; zero ``alert_*`` fields
        appear on this wizard, preserving partition with BM-005's
        ``budget.alert`` model.
    ====================================================================
    -->

    <record id="view_budget_variance_wizard_form" model="ir.ui.view">
        <field name="name">budget.variance.wizard.form</field>
        <field name="model">budget.variance.wizard</field>
        <field name="arch" type="xml">
            <form string="Variance Analysis">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>Variance Analysis</span>
                        </h1>
                        <p>
                            Configure the parameters below and click
                            <strong>Generate Report</strong> to view
                            detailed variance analysis. Use
                            <strong>View Lines</strong> to drill into
                            the supporting transactions with the same
                            filters; click <strong>Preview</strong>
                            to refresh the variance summary in place.
                        </p>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="budget_id"
                                   options="{'no_create': True, 'no_open': False}"/>
                            <field name="company_id"
                                   invisible="not budget_id"/>
                            <field name="currency_id"
                                   invisible="1"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="target_move"
                                   widget="radio"/>
                        </group>
                        <group string="Granularity &amp; Format">
                            <field name="period_granularity"
                                   widget="radio"/>
                            <field name="include_ytd"
                                   invisible="period_granularity == 'none'"/>
                            <field name="show_trend_indicators"
                                   invisible="period_granularity == 'none'"/>
                            <field name="report_format"
                                   widget="radio"/>
                        </group>
                    </group>
                    <group>
                        <group string="Analytic Filters">
                            <field name="analytic_plan_id"
                                   options="{'no_create': True}"/>
                            <field name="analytic_account_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="show_analytic_breakdown"/>
                        </group>
                        <group string="Classification &amp; Notes">
                            <field name="account_type_filter"
                                   widget="radio"/>
                            <field name="classification_filter"
                                   widget="radio"/>
                            <field name="include_notes"/>
                            <field name="notes_filter"/>
                        </group>
                    </group>
                    <group string="Variance Summary"
                           col="4">
                        <field name="variance_line_count"
                               readonly="1"/>
                        <field name="variance_classification"
                               readonly="1"/>
                        <field name="variance_total_budget"
                               readonly="1"/>
                        <field name="variance_total_actual"
                               readonly="1"/>
                        <field name="variance_absolute"
                               readonly="1"/>
                        <field name="variance_percent_display"
                               readonly="1"/>
                        <field name="variance_favorable_amount"
                               readonly="1"/>
                        <field name="variance_unfavorable_amount"
                               readonly="1"/>
                        <field name="variance_net_position"
                               readonly="1"/>
                        <field name="variance_favorable_count"
                               readonly="1"/>
                        <field name="variance_unfavorable_count"
                               readonly="1"/>
                        <field name="variance_trend_period_count"
                               readonly="1"
                               invisible="period_granularity == 'none'"/>
                        <field name="variance_percent"
                               invisible="1"/>
                        <field name="variance_trend_data"
                               invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report"
                            type="object"
                            string="Generate Report"
                            class="btn-primary"/>
                    <button name="action_view_budget_lines"
                            type="object"
                            string="View Lines"
                            class="btn-secondary"/>
                    <button name="action_preview"
                            type="object"
                            string="Preview"
                            class="btn-secondary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_budget_variance_wizard" model="ir.actions.act_window">
        <field name="name">Variance Analysis Wizard</field>
        <field name="res_model">budget.variance.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_budget_variance_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
