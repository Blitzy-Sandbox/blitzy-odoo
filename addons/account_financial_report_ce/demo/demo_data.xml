    Demo Data for Financial Reports
    Provides sample report configurations for testing
-->
<odoo>
    <data noupdate="1">
        <!--
        =======================================================================
        FINANCIAL REPORT DEMO DATA
        =======================================================================

        IMPORTANT — Core Account Module Demo Data Dependency:
        ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        The financial reports in this module operate on the existing
        account.move and account.move.line demo records that are
        automatically created by the core 'account' module's demo
        pipeline (addons/account/demo/account_demo.py).

        The core account module's _get_demo_data() method on
        account.chart.template creates a comprehensive set of
        accounting demo records including:

          - Demo customer invoices (demo_invoice_1 through demo_invoice_8)
            covering various partners, products, and tax scenarios
          - Demo vendor bills and refund entries
          - Demo bank statements with statement lines and balances
          - Demo reconciliation models including regex-based rules
          - Demo payment terms and partner payment configurations
          - Demo analytic plans and account tags

        These records span multiple account types:
          * asset_receivable    — Receivable accounts (Balance Sheet, Aged AR)
          * liability_payable   — Payable accounts (Balance Sheet, Aged AP)
          * income / income_other — Revenue accounts (P&L, Trial Balance)
          * expense / expense_direct_cost — Expense accounts (P&L, Trial Balance)
          * asset_cash / asset_bank — Cash/Bank accounts (Cash Flow, Balance Sheet)
          * equity              — Equity accounts (Balance Sheet)

        This coverage is sufficient to exercise ALL 6 financial report types:
          1. Balance Sheet       — Assets, Liabilities, Equity sections populated
          2. Profit & Loss       — Revenue and expense lines from demo invoices
          3. Cash Flow Statement — Operating/investing/financing from demo moves
          4. General Ledger      — Per-account transaction details available
          5. Trial Balance       — Debit/credit columns from posted entries
          6. Aged AR/AP          — Aging buckets from demo invoice due dates

        No additional account.move or account.move.line records are created
        here because the core module's demo data already provides sufficient
        diversity of account types, partners, and transaction dates.

        Core Demo Record XML-ID References (for documentation):
        ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        The following XML-IDs from the core account module are the primary
        data sources that feed into the financial reports generated by
        this module's wizard presets:

          Invoices & Bills:
            - account.<company_xmlid>_demo_invoice_1 .. demo_invoice_8
            - account.<company_xmlid>_demo_refund_invoice (credit notes)

          Bank Statements:
            - account.<company_xmlid>_demo_bank_statement_1
            - (statement lines are created programmatically, not via XML-ID)

          Reconciliation Models:
            - account.<company_xmlid>_reconcile_model_1
            - (regex-based rule parsing bank transaction labels)

        Note: The <company_xmlid> prefix is dynamically generated by
        account.chart.template.company_xmlid() based on the company record.
        For the main company, this typically resolves to the company's
        database ID or a slug of the company name.

        =======================================================================
        PRE-CONFIGURED REPORT WIZARD PRESETS
        =======================================================================

        The records below create TransientModel entries for
        account.financial.report.wizard that serve as "one-click demo"
        configurations for each of the 6 financial report types.

        EPHEMERAL NATURE: Since account.financial.report.wizard is a
        TransientModel, these records are automatically vacuumed by
        Odoo's transient model cleanup (ir.autovacuum). They exist
        primarily to:
          1. Validate that the demo data XML loads without errors
          2. Document recommended wizard configurations for each report
          3. Provide initial convenience when the module is first installed
             with demo data enabled

        Each preset uses target_move='posted' to show only confirmed
        entries, matching the typical production usage pattern.
        =======================================================================
        -->

        <!-- Preset 1: Balance Sheet — As-of date with prior year comparison -->
        <record id="demo_wizard_balance_sheet" model="account.financial.report.wizard">
            <field name="report_type">balance_sheet</field>
            <field name="date_to" eval="time.strftime('%Y-12-31')"/>
            <field name="target_move">posted</field>
            <field name="enable_comparison" eval="True"/>
            <field name="comparison_date_to" eval="(datetime.now() - relativedelta(years=1)).strftime('%Y-12-31')"/>
            <field name="hide_zero_balance" eval="False"/>
        </record>

        <!-- Preset 2: Profit & Loss — Current fiscal year range -->
        <record id="demo_wizard_profit_loss" model="account.financial.report.wizard">
            <field name="report_type">profit_loss</field>
            <field name="date_from" eval="time.strftime('%Y-01-01')"/>
            <field name="date_to" eval="time.strftime('%Y-12-31')"/>
            <field name="target_move">posted</field>
            <field name="enable_comparison" eval="False"/>
            <field name="hide_zero_balance" eval="False"/>
        </record>

        <!-- Preset 3: Cash Flow Statement — Current fiscal year range -->
        <record id="demo_wizard_cash_flow" model="account.financial.report.wizard">
            <field name="report_type">cash_flow</field>
            <field name="date_from" eval="time.strftime('%Y-01-01')"/>
            <field name="date_to" eval="time.strftime('%Y-12-31')"/>
            <field name="target_move">posted</field>
            <field name="enable_comparison" eval="False"/>
            <field name="hide_zero_balance" eval="False"/>
        </record>

        <!-- Preset 4: General Ledger — All accounts, current fiscal year -->
        <record id="demo_wizard_general_ledger" model="account.financial.report.wizard">
            <field name="report_type">general_ledger</field>
            <field name="date_from" eval="time.strftime('%Y-01-01')"/>
            <field name="date_to" eval="time.strftime('%Y-12-31')"/>
            <field name="target_move">posted</field>
            <field name="include_initial_balance" eval="True"/>
            <field name="sort_by">date</field>
            <field name="hide_zero_balance" eval="False"/>
        </record>

        <!-- Preset 5: Trial Balance — As-of date, hide zero balances -->
        <record id="demo_wizard_trial_balance" model="account.financial.report.wizard">
            <field name="report_type">trial_balance</field>
            <field name="date_to" eval="time.strftime('%Y-12-31')"/>
            <field name="target_move">posted</field>
            <field name="hide_zero_balance" eval="True"/>
            <field name="enable_comparison" eval="False"/>
        </record>

        <!-- Preset 6: Aged Receivables — Current date, all partners -->
        <record id="demo_wizard_aged_receivable" model="account.financial.report.wizard">
            <field name="report_type">aged_receivable</field>
            <field name="date_to" eval="time.strftime('%Y-%m-%d')"/>
            <field name="target_move">posted</field>
            <field name="hide_zero_balance" eval="False"/>
        </record>

        <!-- Preset 7: Aged Payables — Current date, all partners -->
        <record id="demo_wizard_aged_payable" model="account.financial.report.wizard">
            <field name="report_type">aged_payable</field>
            <field name="date_to" eval="time.strftime('%Y-%m-%d')"/>
            <field name="target_move">posted</field>
            <field name="hide_zero_balance" eval="False"/>
        </record>

    </data>
</odoo>
