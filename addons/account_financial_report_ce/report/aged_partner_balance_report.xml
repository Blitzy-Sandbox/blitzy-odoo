    Aged Partner Balance Report Template (FR-006)
    Implements aged receivables/payables report with:
    - Configurable aging buckets (30/60/90/120+ days)
    - Partner breakdown with contact information
    - Total by aging bucket
    - Drill-down to invoices
-->
<odoo>
    <template id="report_aged_partner_balance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Report Header -->
                        <div class="text-center">
                            <h2>
                                Aged 
                                <t t-if="doc.partner_type == 'customer'">Receivable</t>
                                <t t-else="">Payable</t>
                                Balance
                            </h2>
                            <p>
                                <strong>As of: </strong>
                                <span t-field="doc.date_at"/>
                            </p>
                            <p t-if="doc.company_id">
                                <span t-field="doc.company_id.name"/>
                            </p>
                        </div>

                        <!-- Report Parameters -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Partner Type:</strong></td>
                                        <td>
                                            <t t-if="doc.partner_type == 'customer'">Customers (Receivables)</t>
                                            <t t-else="">Suppliers (Payables)</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Target Moves:</strong></td>
                                        <td>
                                            <t t-if="doc.target_move == 'posted'">Posted Entries Only</t>
                                            <t t-else="">All Entries</t>
                                        </td>
                                    </tr>
                                    <tr t-if="doc.partner_ids">
                                        <td><strong>Filtered Partners:</strong></td>
                                        <td><span t-esc="len(doc.partner_ids)"/> partners selected</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Show Details:</strong></td>
                                        <td>
                                            <t t-if="doc.show_move_lines">Yes (Invoice Level)</t>
                                            <t t-else="">No (Partner Summary Only)</t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Aging Periods:</strong></td>
                                        <td>
                                            Current, 1-30, 31-60, 61-90, 91-120, 120+ days
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Aged Balance Table -->
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr class="bg-primary text-white">
                                    <th style="width: 25%">Partner</th>
                                    <th class="text-end" style="width: 10%">Not Due</th>
                                    <th class="text-end" style="width: 10%">1-30</th>
                                    <th class="text-end" style="width: 10%">31-60</th>
                                    <th class="text-end" style="width: 10%">61-90</th>
                                    <th class="text-end" style="width: 10%">91-120</th>
                                    <th class="text-end" style="width: 10%">120+</th>
                                    <th class="text-end" style="width: 15%">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Initialize totals -->
                                <t t-set="grand_not_due" t-value="0"/>
                                <t t-set="grand_1_30" t-value="0"/>
                                <t t-set="grand_31_60" t-value="0"/>
                                <t t-set="grand_61_90" t-value="0"/>
                                <t t-set="grand_91_120" t-value="0"/>
                                <t t-set="grand_120_plus" t-value="0"/>
                                <t t-set="grand_total" t-value="0"/>

                                <!-- Partner Lines -->
                                <t t-foreach="doc.partner_ids or doc.line_ids.mapped('partner_id')" t-as="partner">
                                    <t t-set="partner_lines" t-value="doc.line_ids.filtered(lambda l: l.partner_id == partner)"/>
                                    <t t-if="partner_lines">
                                        <!-- Calculate partner aging buckets -->
                                        <t t-set="partner_not_due" t-value="sum(partner_lines.filtered(lambda l: l.age_bucket == 'not_due').mapped('amount_residual'))"/>
                                        <t t-set="partner_1_30" t-value="sum(partner_lines.filtered(lambda l: l.age_bucket == '1_30').mapped('amount_residual'))"/>
                                        <t t-set="partner_31_60" t-value="sum(partner_lines.filtered(lambda l: l.age_bucket == '31_60').mapped('amount_residual'))"/>
                                        <t t-set="partner_61_90" t-value="sum(partner_lines.filtered(lambda l: l.age_bucket == '61_90').mapped('amount_residual'))"/>
                                        <t t-set="partner_91_120" t-value="sum(partner_lines.filtered(lambda l: l.age_bucket == '91_120').mapped('amount_residual'))"/>
                                        <t t-set="partner_120_plus" t-value="sum(partner_lines.filtered(lambda l: l.age_bucket == '120_plus').mapped('amount_residual'))"/>
                                        <t t-set="partner_total" t-value="partner_not_due + partner_1_30 + partner_31_60 + partner_61_90 + partner_91_120 + partner_120_plus"/>

                                        <!-- Partner Summary Row -->
                                        <tr class="table-light">
                                            <td>
                                                <strong>
                                                    <a t-att-href="'/web#model=res.partner&amp;id=%s&amp;view_type=form' % partner.id"
                                                       class="text-primary">
                                                        <span t-esc="partner.name"/>
                                                    </a>
                                                </strong>
                                                <br/>
                                                <small class="text-muted" t-if="partner.email">
                                                    <span t-esc="partner.email"/>
                                                </small>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="partner_not_due">
                                                    <span t-esc="partner_not_due" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="partner_1_30">
                                                    <span t-esc="partner_1_30" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="partner_31_60">
                                                    <span t-esc="partner_31_60" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="partner_61_90">
                                                    <span t-esc="partner_61_90" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="partner_91_120">
                                                    <span class="text-warning" t-esc="partner_91_120" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="partner_120_plus">
                                                    <span class="text-danger fw-bold" t-esc="partner_120_plus" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <strong t-esc="partner_total" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                        </tr>

                                        <!-- Detail Lines (if enabled) -->
                                        <t t-if="doc.show_move_lines">
                                            <t t-foreach="partner_lines.sorted(key=lambda l: l.date_due or l.date)" t-as="line">
                                                <tr class="small">
                                                    <td class="ps-4">
                                                        <a t-att-href="'/web#model=account.move&amp;id=%s&amp;view_type=form' % line.move_id.id"
                                                           class="text-muted">
                                                            <span t-esc="line.move_id.name"/>
                                                        </a>
                                                        <span class="text-muted ms-2">
                                                            Due: <span t-field="line.date_due"/>
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="line.age_bucket == 'not_due'">
                                                            <span t-esc="line.amount_residual" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="line.age_bucket == '1_30'">
                                                            <span t-esc="line.amount_residual" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="line.age_bucket == '31_60'">
                                                            <span t-esc="line.amount_residual" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="line.age_bucket == '61_90'">
                                                            <span t-esc="line.amount_residual" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="line.age_bucket == '91_120'">
                                                            <span class="text-warning" t-esc="line.amount_residual" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="line.age_bucket == '120_plus'">
                                                            <span class="text-danger" t-esc="line.amount_residual" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-esc="line.amount_residual" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>

                                        <!-- Accumulate grand totals -->
                                        <t t-set="grand_not_due" t-value="grand_not_due + partner_not_due"/>
                                        <t t-set="grand_1_30" t-value="grand_1_30 + partner_1_30"/>
                                        <t t-set="grand_31_60" t-value="grand_31_60 + partner_31_60"/>
                                        <t t-set="grand_61_90" t-value="grand_61_90 + partner_61_90"/>
                                        <t t-set="grand_91_120" t-value="grand_91_120 + partner_91_120"/>
                                        <t t-set="grand_120_plus" t-value="grand_120_plus + partner_120_plus"/>
                                        <t t-set="grand_total" t-value="grand_total + partner_total"/>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <!-- Grand Totals -->
                                <tr class="table-primary">
                                    <td><strong>GRAND TOTAL</strong></td>
                                    <td class="text-end">
                                        <strong t-esc="grand_not_due" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="grand_1_30" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="grand_31_60" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="grand_61_90" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <strong class="text-warning" t-esc="grand_91_120" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <strong class="text-danger" t-esc="grand_120_plus" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="grand_total" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                </tr>
                                <!-- Percentage Row -->
                                <tr class="table-secondary small" t-if="grand_total">
                                    <td><em>% of Total</em></td>
                                    <td class="text-end"><span t-esc="'%.1f%%' % (grand_not_due / grand_total * 100)"/></td>
                                    <td class="text-end"><span t-esc="'%.1f%%' % (grand_1_30 / grand_total * 100)"/></td>
                                    <td class="text-end"><span t-esc="'%.1f%%' % (grand_31_60 / grand_total * 100)"/></td>
                                    <td class="text-end"><span t-esc="'%.1f%%' % (grand_61_90 / grand_total * 100)"/></td>
                                    <td class="text-end"><span t-esc="'%.1f%%' % (grand_91_120 / grand_total * 100)"/></td>
                                    <td class="text-end"><span t-esc="'%.1f%%' % (grand_120_plus / grand_total * 100)"/></td>
                                    <td class="text-end">100%</td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Aging Summary Chart (Visual representation using table bars) -->
                        <div class="mt-4">
                            <h5>Aging Distribution</h5>
                            <t t-if="grand_total">
                                <div class="progress" style="height: 30px;">
                                    <div class="progress-bar bg-success" role="progressbar" 
                                         t-att-style="'width: %s%%' % (grand_not_due / grand_total * 100)"
                                         t-att-title="'Not Due: ' + str(grand_not_due)">
                                        Not Due
                                    </div>
                                    <div class="progress-bar bg-info" role="progressbar"
                                         t-att-style="'width: %s%%' % (grand_1_30 / grand_total * 100)"
                                         t-att-title="'1-30: ' + str(grand_1_30)">
                                        1-30
                                    </div>
                                    <div class="progress-bar bg-primary" role="progressbar"
                                         t-att-style="'width: %s%%' % (grand_31_60 / grand_total * 100)"
                                         t-att-title="'31-60: ' + str(grand_31_60)">
                                        31-60
                                    </div>
                                    <div class="progress-bar bg-secondary" role="progressbar"
                                         t-att-style="'width: %s%%' % (grand_61_90 / grand_total * 100)"
                                         t-att-title="'61-90: ' + str(grand_61_90)">
                                        61-90
                                    </div>
                                    <div class="progress-bar bg-warning" role="progressbar"
                                         t-att-style="'width: %s%%' % (grand_91_120 / grand_total * 100)"
                                         t-att-title="'91-120: ' + str(grand_91_120)">
                                        91-120
                                    </div>
                                    <div class="progress-bar bg-danger" role="progressbar"
                                         t-att-style="'width: %s%%' % (grand_120_plus / grand_total * 100)"
                                         t-att-title="'120+: ' + str(grand_120_plus)">
                                        120+
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Collection Risk Summary -->
                        <div class="row mt-4">
                            <div class="col-6">
                                <h5>Collection Risk Summary</h5>
                                <table class="table table-sm table-bordered">
                                    <tr>
                                        <td>Current (Not Due + 1-30 days)</td>
                                        <td class="text-end text-success">
                                            <span t-esc="grand_not_due + grand_1_30" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Aging (31-90 days)</td>
                                        <td class="text-end text-warning">
                                            <span t-esc="grand_31_60 + grand_61_90" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>At Risk (91+ days)</td>
                                        <td class="text-end text-danger">
                                            <span t-esc="grand_91_120 + grand_120_plus" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <h5>Partner Statistics</h5>
                                <table class="table table-sm table-bordered">
                                    <t t-set="unique_partners" t-value="len(doc.line_ids.mapped('partner_id'))"/>
                                    <tr>
                                        <td>Total Partners</td>
                                        <td class="text-end"><span t-esc="unique_partners"/></td>
                                    </tr>
                                    <tr>
                                        <td>Average Balance</td>
                                        <td class="text-end">
                                            <t t-if="unique_partners">
                                                <span t-esc="grand_total / unique_partners" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Open Invoices</td>
                                        <td class="text-end"><span t-esc="len(doc.line_ids)"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Report Footer -->
                        <div class="mt-4 text-muted small">
                            <p>
                                Generated on: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
                                <br/>
                                Report ID: <span t-field="doc.id"/>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
