    General Ledger Report Template (FR-004)
    Implements comprehensive general ledger with:
    - Transaction details by account with running balance
    - Opening and closing balances per account
    - Drill-down to source documents with tooltips
    - Multi-currency support (conditional foreign currency columns)
    - Grand totals with debit, credit, and balance summaries
    - Sorting respects model sort_by preference (date/ref/name)
-->
<odoo>
    <template id="report_general_ledger">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Report Header -->
                        <div class="text-center">
                            <h2>General Ledger</h2>
                            <p>
                                <strong>Period: </strong>
                                <span t-field="doc.date_from"/> to <span t-field="doc.date_to"/>
                            </p>
                            <p t-if="doc.company_id">
                                <span t-field="doc.company_id.name"/>
                            </p>
                        </div>

                        <!-- Report Parameters -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Target Moves:</strong></td>
                                        <td>
                                            <t t-if="doc.target_move == 'posted'">Posted Entries Only</t>
                                            <t t-else="">All Entries</t>
                                        </td>
                                    </tr>
                                    <tr t-if="doc.account_ids">
                                        <td><strong>Filtered Accounts:</strong></td>
                                        <td><span t-esc="len(doc.account_ids)"/> accounts selected</td>
                                    </tr>
                                    <tr t-if="doc.partner_ids">
                                        <td><strong>Filtered Partners:</strong></td>
                                        <td><span t-esc="len(doc.partner_ids)"/> partners selected</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Show Details:</strong></td>
                                        <td>
                                            <t t-if="doc.show_details">Yes</t>
                                            <t t-else="">No (Summary Only)</t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Detect foreign currency transactions for conditional multi-currency columns.
                             Checks if any non-opening/non-closing line has a transaction currency
                             that differs from the company currency. When true, extra columns for
                             original currency amount and currency code are rendered. -->
                        <t t-set="all_period_lines" t-value="doc.line_ids.filtered(lambda l: not l.is_opening and not l.is_closing)"/>
                        <t t-set="foreign_currency_lines" t-value="all_period_lines.filtered(lambda l: l.move_line_id.currency_id and l.move_line_id.currency_id.id != doc.company_id.currency_id.id)"/>
                        <t t-set="show_foreign_currency" t-value="bool(foreign_currency_lines)"/>

                        <!-- Grand total accumulators for debit, credit, and running balance -->
                        <t t-set="grand_opening_debit" t-value="0"/>
                        <t t-set="grand_opening_credit" t-value="0"/>
                        <t t-set="grand_opening_balance" t-value="0"/>
                        <t t-set="grand_debit" t-value="0"/>
                        <t t-set="grand_credit" t-value="0"/>
                        <t t-set="grand_period_balance" t-value="0"/>
                        <t t-set="grand_closing_debit" t-value="0"/>
                        <t t-set="grand_closing_credit" t-value="0"/>
                        <t t-set="grand_closing_balance" t-value="0"/>

                        <!-- General Ledger by Account -->
                        <t t-foreach="doc.account_ids or doc.line_ids.mapped('account_id')" t-as="account">
                            <t t-set="account_lines" t-value="doc.line_ids.filtered(lambda l: l.account_id == account)"/>
                            <t t-if="account_lines or not doc.hide_account_at_0">

                                <!-- Account Header with code and name -->
                                <div class="mt-4">
                                    <h5 class="bg-light p-2">
                                        <span t-esc="account.code"/> - <span t-esc="account.name"/>
                                    </h5>
                                </div>

                                <!-- Per-account transaction table with 8 columns (+ optional multi-currency) -->
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr class="bg-secondary text-white">
                                            <!-- Base 8 columns: Date, Journal, Document, Partner, Label, Debit, Credit, Balance -->
                                            <th t-att-style="'width: %s' % ('9%%' if not show_foreign_currency else '7%%')">Date</th>
                                            <th t-att-style="'width: %s' % ('10%%' if not show_foreign_currency else '8%%')">Journal</th>
                                            <th t-att-style="'width: %s' % ('13%%' if not show_foreign_currency else '10%%')">Document</th>
                                            <th t-att-style="'width: %s' % ('15%%' if not show_foreign_currency else '12%%')">Partner</th>
                                            <th t-att-style="'width: %s' % ('18%%' if not show_foreign_currency else '14%%')">Label</th>
                                            <th class="text-end" t-att-style="'width: %s' % ('11%%' if not show_foreign_currency else '9%%')">Debit</th>
                                            <th class="text-end" t-att-style="'width: %s' % ('11%%' if not show_foreign_currency else '9%%')">Credit</th>
                                            <th class="text-end" t-att-style="'width: %s' % ('13%%' if not show_foreign_currency else '10%%')">Balance</th>
                                            <!-- Conditional multi-currency columns for foreign currency transactions -->
                                            <th t-if="show_foreign_currency" class="text-end" style="width: 12%">Amt Currency</th>
                                            <th t-if="show_foreign_currency" class="text-end" style="width: 9%">Currency</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Opening Balance row with debit, credit, and computed running balance -->
                                        <t t-set="opening_debit" t-value="sum(account_lines.filtered(lambda l: l.is_opening).mapped('debit'))"/>
                                        <t t-set="opening_credit" t-value="sum(account_lines.filtered(lambda l: l.is_opening).mapped('credit'))"/>
                                        <t t-set="opening_balance" t-value="opening_debit - opening_credit"/>
                                        <tr class="table-light">
                                            <td colspan="5"><strong>Opening Balance</strong></td>
                                            <td class="text-end">
                                                <strong t-esc="opening_debit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <strong t-esc="opening_credit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <strong t-esc="opening_balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                            <!-- Empty multi-currency cells for opening balance row -->
                                            <td t-if="show_foreign_currency"/>
                                            <td t-if="show_foreign_currency"/>
                                        </tr>

                                        <!-- Transaction Lines — sorted by model's sort_by preference,
                                             no hardcoded re-sort in template. The model's _compute_report_data
                                             already orders lines according to doc.sort_by (date/ref/name). -->
                                        <t t-if="doc.show_details">
                                            <t t-set="period_lines" t-value="account_lines.filtered(lambda l: not l.is_opening and not l.is_closing)"/>
                                            <t t-foreach="period_lines" t-as="line">
                                                <tr>
                                                    <td><span t-field="line.date"/></td>
                                                    <td><span t-esc="line.journal_id.code"/></td>
                                                    <td>
                                                        <!-- Drill-down link to source journal entry with view_type=form parameter
                                                             and tooltip displaying the full move reference for quick identification -->
                                                        <a t-att-href="'/web#model=account.move&amp;id=%s&amp;view_type=form' % line.move_id.id"
                                                           class="text-primary"
                                                           t-att-title="'%s — %s' % (line.move_id.name or '', line.ref or line.move_id.ref or '')">
                                                            <span t-esc="line.move_id.name"/>
                                                        </a>
                                                    </td>
                                                    <td><span t-esc="line.partner_id.name or ''"/></td>
                                                    <td><span t-esc="line.name or line.ref or ''"/></td>
                                                    <td class="text-end">
                                                        <t t-if="line.debit">
                                                            <span t-esc="line.debit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="line.credit">
                                                            <span t-esc="line.credit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <!-- Running balance column — displays cumulative balance per account
                                                         from opening through each transaction line -->
                                                    <td class="text-end">
                                                        <span t-esc="line.balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                    </td>
                                                    <!-- Conditional multi-currency columns: original transaction amount
                                                         and currency code shown only when the line's currency differs
                                                         from the company currency -->
                                                    <t t-if="show_foreign_currency">
                                                        <td class="text-end">
                                                            <t t-if="line.move_line_id.currency_id and line.move_line_id.currency_id.id != doc.company_id.currency_id.id">
                                                                <span t-esc="line.move_line_id.amount_currency" t-options="{'widget': 'monetary', 'display_currency': line.move_line_id.currency_id}"/>
                                                            </t>
                                                        </td>
                                                        <td class="text-end">
                                                            <t t-if="line.move_line_id.currency_id and line.move_line_id.currency_id.id != doc.company_id.currency_id.id">
                                                                <span t-esc="line.move_line_id.currency_id.name"/>
                                                            </t>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </t>
                                        </t>

                                        <!-- Period Totals row with debit, credit, and net period balance -->
                                        <t t-set="period_debit" t-value="sum(account_lines.filtered(lambda l: not l.is_opening and not l.is_closing).mapped('debit'))"/>
                                        <t t-set="period_credit" t-value="sum(account_lines.filtered(lambda l: not l.is_opening and not l.is_closing).mapped('credit'))"/>
                                        <t t-set="period_balance" t-value="period_debit - period_credit"/>
                                        <tr class="table-info">
                                            <td colspan="5"><strong>Period Movement</strong></td>
                                            <td class="text-end">
                                                <strong t-esc="period_debit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <strong t-esc="period_credit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <strong t-esc="period_balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                            <!-- Empty multi-currency cells for period movement row -->
                                            <td t-if="show_foreign_currency"/>
                                            <td t-if="show_foreign_currency"/>
                                        </tr>

                                        <!-- Closing Balance row: opening + period movement, with running balance -->
                                        <t t-set="closing_debit" t-value="opening_debit + period_debit"/>
                                        <t t-set="closing_credit" t-value="opening_credit + period_credit"/>
                                        <t t-set="closing_balance" t-value="opening_balance + period_balance"/>
                                        <tr class="table-primary">
                                            <td colspan="5"><strong>Closing Balance</strong></td>
                                            <td class="text-end">
                                                <strong t-esc="closing_debit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <strong t-esc="closing_credit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <strong t-esc="closing_balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                            <!-- Empty multi-currency cells for closing balance row -->
                                            <td t-if="show_foreign_currency"/>
                                            <td t-if="show_foreign_currency"/>
                                        </tr>
                                    </tbody>
                                </table>

                                <!-- Accumulate grand totals across all accounts for summary table -->
                                <t t-set="grand_opening_debit" t-value="grand_opening_debit + opening_debit"/>
                                <t t-set="grand_opening_credit" t-value="grand_opening_credit + opening_credit"/>
                                <t t-set="grand_opening_balance" t-value="grand_opening_balance + opening_balance"/>
                                <t t-set="grand_debit" t-value="grand_debit + period_debit"/>
                                <t t-set="grand_credit" t-value="grand_credit + period_credit"/>
                                <t t-set="grand_period_balance" t-value="grand_period_balance + period_balance"/>
                                <t t-set="grand_closing_debit" t-value="grand_closing_debit + closing_debit"/>
                                <t t-set="grand_closing_credit" t-value="grand_closing_credit + closing_credit"/>
                                <t t-set="grand_closing_balance" t-value="grand_closing_balance + closing_balance"/>
                            </t>
                        </t>

                        <!-- Grand Totals summary table with Debit, Credit, and Balance columns
                             consistent with per-account table structure -->
                        <div class="mt-5">
                            <h5>Grand Totals</h5>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr class="bg-dark text-white">
                                        <th>Category</th>
                                        <th class="text-end">Debit</th>
                                        <th class="text-end">Credit</th>
                                        <th class="text-end">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Opening Balance</td>
                                        <td class="text-end">
                                            <span t-esc="grand_opening_debit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="grand_opening_credit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="grand_opening_balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Period Movement</td>
                                        <td class="text-end">
                                            <span t-esc="grand_debit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="grand_credit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="grand_period_balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr class="table-primary">
                                        <td><strong>Closing Balance</strong></td>
                                        <td class="text-end">
                                            <strong t-esc="grand_closing_debit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <strong t-esc="grand_closing_credit" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <strong t-esc="grand_closing_balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Report Footer -->
                        <div class="mt-4 text-muted small">
                            <p>
                                Generated on: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
                                <br/>
                                Report ID: <span t-field="doc.id"/>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
