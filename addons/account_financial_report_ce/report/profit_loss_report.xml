    Profit and Loss Statement Report Template (FR-002)
    Implements GAAP/IFRS compliant income statement with:
    - Revenue, COGS, Operating Expenses, Other Income/Expenses sections
    - Gross Profit, Operating Income, Net Income calculations
    - Comparative period columns
-->
<odoo>
    <template id="report_profit_loss">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Report Header -->
                        <div class="text-center">
                            <h2>Profit and Loss Statement</h2>
                            <p>
                                <strong>Period: </strong>
                                <span t-field="doc.date_from"/> to <span t-field="doc.date_to"/>
                                <t t-if="doc.compare_period">
                                    <span> vs </span>
                                    <span t-field="doc.compare_date_from"/> to <span t-field="doc.compare_date_to"/>
                                </t>
                            </p>
                            <p t-if="doc.company_id">
                                <span t-field="doc.company_id.name"/>
                            </p>
                        </div>

                        <!-- Report Parameters -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Target Moves:</strong></td>
                                        <td>
                                            <t t-if="doc.target_move == 'posted'">Posted Entries Only</t>
                                            <t t-else="">All Entries</t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Profit & Loss Table -->
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr class="bg-primary text-white">
                                    <th style="width: 60%">Account</th>
                                    <th class="text-end" style="width: 20%">Current Period</th>
                                    <t t-if="doc.compare_period">
                                        <th class="text-end" style="width: 20%">Prior Period</th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- REVENUE Section -->
                                <tr class="table-secondary">
                                    <td colspan="3"><strong>REVENUE</strong></td>
                                </tr>
                                <t t-set="total_revenue" t-value="0"/>
                                <t t-set="total_revenue_compare" t-value="0"/>
                                <t t-foreach="doc.line_ids.filtered(lambda l: l.section == 'revenue')" t-as="line">
                                    <tr>
                                        <td>
                                            <t t-if="line.is_group">
                                                <strong t-esc="line.display_name"/>
                                            </t>
                                            <t t-else="">
                                                <a t-attf-href="/web#model=account.move.line&amp;view_type=list&amp;domain=[('account_id','=',{{ line.account_id.id }})]"
                                                   class="text-primary">
                                                    <span t-esc="line.account_code"/> - <span t-esc="line.account_name"/>
                                                </a>
                                            </t>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="line.balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <t t-if="doc.compare_period">
                                            <td class="text-end">
                                                <span t-esc="line.balance_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-set="total_revenue" t-value="total_revenue + line.balance"/>
                                    <t t-set="total_revenue_compare" t-value="total_revenue_compare + (line.balance_compare or 0)"/>
                                </t>
                                <tr class="table-info">
                                    <td><strong>Total Revenue</strong></td>
                                    <td class="text-end">
                                        <strong t-esc="total_revenue" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <t t-if="doc.compare_period">
                                        <td class="text-end">
                                            <strong t-esc="total_revenue_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- COST OF GOODS SOLD Section -->
                                <tr class="table-secondary">
                                    <td colspan="3"><strong>COST OF GOODS SOLD</strong></td>
                                </tr>
                                <t t-set="total_cogs" t-value="0"/>
                                <t t-set="total_cogs_compare" t-value="0"/>
                                <t t-foreach="doc.line_ids.filtered(lambda l: l.section == 'cogs')" t-as="line">
                                    <tr>
                                        <td>
                                            <t t-if="line.is_group">
                                                <strong t-esc="line.display_name"/>
                                            </t>
                                            <t t-else="">
                                                <a t-attf-href="/web#model=account.move.line&amp;view_type=list&amp;domain=[('account_id','=',{{ line.account_id.id }})]"
                                                   class="text-primary">
                                                    <span t-esc="line.account_code"/> - <span t-esc="line.account_name"/>
                                                </a>
                                            </t>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="line.balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <t t-if="doc.compare_period">
                                            <td class="text-end">
                                                <span t-esc="line.balance_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-set="total_cogs" t-value="total_cogs + line.balance"/>
                                    <t t-set="total_cogs_compare" t-value="total_cogs_compare + (line.balance_compare or 0)"/>
                                </t>
                                <tr class="table-info">
                                    <td><strong>Total COGS</strong></td>
                                    <td class="text-end">
                                        <strong t-esc="total_cogs" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <t t-if="doc.compare_period">
                                        <td class="text-end">
                                            <strong t-esc="total_cogs_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- GROSS PROFIT -->
                                <tr class="table-success">
                                    <td><strong>GROSS PROFIT</strong></td>
                                    <td class="text-end">
                                        <strong t-esc="total_revenue - total_cogs" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <t t-if="doc.compare_period">
                                        <td class="text-end">
                                            <strong t-esc="total_revenue_compare - total_cogs_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- OPERATING EXPENSES Section -->
                                <tr class="table-secondary">
                                    <td colspan="3"><strong>OPERATING EXPENSES</strong></td>
                                </tr>
                                <t t-set="total_opex" t-value="0"/>
                                <t t-set="total_opex_compare" t-value="0"/>
                                <t t-foreach="doc.line_ids.filtered(lambda l: l.section == 'expense')" t-as="line">
                                    <tr>
                                        <td>
                                            <t t-if="line.is_group">
                                                <strong t-esc="line.display_name"/>
                                            </t>
                                            <t t-else="">
                                                <a t-attf-href="/web#model=account.move.line&amp;view_type=list&amp;domain=[('account_id','=',{{ line.account_id.id }})]"
                                                   class="text-primary">
                                                    <span t-esc="line.account_code"/> - <span t-esc="line.account_name"/>
                                                </a>
                                            </t>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="line.balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <t t-if="doc.compare_period">
                                            <td class="text-end">
                                                <span t-esc="line.balance_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-set="total_opex" t-value="total_opex + line.balance"/>
                                    <t t-set="total_opex_compare" t-value="total_opex_compare + (line.balance_compare or 0)"/>
                                </t>
                                <tr class="table-info">
                                    <td><strong>Total Operating Expenses</strong></td>
                                    <td class="text-end">
                                        <strong t-esc="total_opex" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <t t-if="doc.compare_period">
                                        <td class="text-end">
                                            <strong t-esc="total_opex_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- OPERATING INCOME -->
                                <t t-set="operating_income" t-value="total_revenue - total_cogs - total_opex"/>
                                <t t-set="operating_income_compare" t-value="total_revenue_compare - total_cogs_compare - total_opex_compare"/>
                                <tr class="table-success">
                                    <td><strong>OPERATING INCOME</strong></td>
                                    <td class="text-end">
                                        <strong t-esc="operating_income" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <t t-if="doc.compare_period">
                                        <td class="text-end">
                                            <strong t-esc="operating_income_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- OTHER INCOME/EXPENSES Section -->
                                <tr class="table-secondary">
                                    <td colspan="3"><strong>OTHER INCOME/EXPENSES</strong></td>
                                </tr>
                                <t t-set="total_other" t-value="0"/>
                                <t t-set="total_other_compare" t-value="0"/>
                                <t t-foreach="doc.line_ids.filtered(lambda l: l.section == 'other')" t-as="line">
                                    <tr>
                                        <td>
                                            <t t-if="line.is_group">
                                                <strong t-esc="line.display_name"/>
                                            </t>
                                            <t t-else="">
                                                <a t-attf-href="/web#model=account.move.line&amp;view_type=list&amp;domain=[('account_id','=',{{ line.account_id.id }})]"
                                                   class="text-primary">
                                                    <span t-esc="line.account_code"/> - <span t-esc="line.account_name"/>
                                                </a>
                                            </t>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="line.balance" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <t t-if="doc.compare_period">
                                            <td class="text-end">
                                                <span t-esc="line.balance_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-set="total_other" t-value="total_other + line.balance"/>
                                    <t t-set="total_other_compare" t-value="total_other_compare + (line.balance_compare or 0)"/>
                                </t>
                                <tr class="table-info">
                                    <td><strong>Total Other Income/Expenses</strong></td>
                                    <td class="text-end">
                                        <strong t-esc="total_other" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <t t-if="doc.compare_period">
                                        <td class="text-end">
                                            <strong t-esc="total_other_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- NET INCOME -->
                                <t t-set="net_income" t-value="operating_income + total_other"/>
                                <t t-set="net_income_compare" t-value="operating_income_compare + total_other_compare"/>
                                <tr class="table-primary">
                                    <td><strong>NET INCOME</strong></td>
                                    <td class="text-end">
                                        <strong t-esc="net_income" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                    <t t-if="doc.compare_period">
                                        <td class="text-end">
                                            <strong t-esc="net_income_compare" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Margin Analysis -->
                        <div class="mt-4" t-if="total_revenue != 0">
                            <h5>Margin Analysis</h5>
                            <table class="table table-sm table-bordered" style="width: 50%">
                                <tr>
                                    <td>Gross Margin</td>
                                    <td class="text-end">
                                        <span t-esc="'%.1f%%' % ((total_revenue - total_cogs) / total_revenue * 100)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Operating Margin</td>
                                    <td class="text-end">
                                        <span t-esc="'%.1f%%' % (operating_income / total_revenue * 100)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Net Margin</td>
                                    <td class="text-end">
                                        <span t-esc="'%.1f%%' % (net_income / total_revenue * 100)"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Report Footer -->
                        <div class="mt-4 text-muted small">
                            <p>
                                Generated on: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
                                <br/>
                                Report ID: <span t-field="doc.id"/>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
