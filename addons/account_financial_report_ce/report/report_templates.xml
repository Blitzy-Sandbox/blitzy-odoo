<odoo>
    <!-- Report Actions -->
    
    <!-- Balance Sheet Report Action -->
    <record id="action_report_balance_sheet" model="ir.actions.report">
        <field name="name">Balance Sheet</field>
        <field name="model">account.balance.sheet.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_financial_report_ce.report_balance_sheet</field>
        <field name="report_file">account_financial_report_ce.report_balance_sheet</field>
        <field name="print_report_name">'Balance Sheet - %s' % (object.date_to)</field>
        <field name="binding_model_id" ref="model_account_balance_sheet_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Profit and Loss Report Action -->
    <record id="action_report_profit_loss" model="ir.actions.report">
        <field name="name">Profit and Loss Statement</field>
        <field name="model">account.profit.loss.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_financial_report_ce.report_profit_loss</field>
        <field name="report_file">account_financial_report_ce.report_profit_loss</field>
        <field name="print_report_name">'Profit and Loss - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="binding_model_id" ref="model_account_profit_loss_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Cash Flow Statement Report Action -->
    <record id="action_report_cash_flow" model="ir.actions.report">
        <field name="name">Cash Flow Statement</field>
        <field name="model">account.cash.flow.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_financial_report_ce.report_cash_flow</field>
        <field name="report_file">account_financial_report_ce.report_cash_flow</field>
        <field name="print_report_name">'Cash Flow Statement - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="binding_model_id" ref="model_account_cash_flow_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- General Ledger Report Action -->
    <record id="action_report_general_ledger" model="ir.actions.report">
        <field name="name">General Ledger</field>
        <field name="model">account.general.ledger.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_financial_report_ce.report_general_ledger</field>
        <field name="report_file">account_financial_report_ce.report_general_ledger</field>
        <field name="print_report_name">'General Ledger - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="binding_model_id" ref="model_account_general_ledger_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Trial Balance Report Action -->
    <record id="action_report_trial_balance" model="ir.actions.report">
        <field name="name">Trial Balance</field>
        <field name="model">account.trial.balance.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_financial_report_ce.report_trial_balance</field>
        <field name="report_file">account_financial_report_ce.report_trial_balance</field>
        <field name="print_report_name">'Trial Balance - %s' % (object.date_to)</field>
        <field name="binding_model_id" ref="model_account_trial_balance_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Aged Partner Balance Report Action -->
    <record id="action_report_aged_partner_balance" model="ir.actions.report">
        <field name="name">Aged Partner Balance</field>
        <field name="model">account.aged.partner.balance.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_financial_report_ce.report_aged_partner_balance</field>
        <field name="report_file">account_financial_report_ce.report_aged_partner_balance</field>
        <field name="print_report_name">'Aged %s - %s' % ('Receivable' if object.partner_type == 'customer' else 'Payable', object.date_at)</field>
        <field name="binding_model_id" ref="model_account_aged_partner_balance_report"/>
        <field name="binding_type">report</field>
    </record>

    <!--
        XLSX export is handled programmatically via wizard action_export_xlsx()
        using openpyxl/XlsxWriter in Python, not through ir.actions.report.
        Standard Odoo 19.0 only supports qweb-html, qweb-pdf, qweb-text report types.
    -->

</odoo>
