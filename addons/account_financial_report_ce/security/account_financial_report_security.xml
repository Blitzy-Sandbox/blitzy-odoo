<odoo>
    <data noupdate="1">
        
        <!-- Financial Reports User Group -->
        <record id="group_financial_report_user" model="res.groups">
            <field name="name">Financial Reports User</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
            <field name="comment">Users can view and generate financial reports.</field>
        </record>
        
        <!-- Financial Reports Manager Group -->
        <record id="group_financial_report_manager" model="res.groups">
            <field name="name">Financial Reports Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_financial_report_user')), (4, ref('account.group_account_manager'))]"/>
            <field name="comment">Managers can configure and customize financial reports.</field>
        </record>

        <!-- Multi-company record rules for financial reports -->
        <!-- Ensures users only see reports belonging to their assigned companies -->

        <record id="financial_report_wizard_comp_rule" model="ir.rule">
            <field name="name">Financial Report Wizard multi-company</field>
            <field name="model_id" ref="model_account_financial_report_wizard"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="balance_sheet_report_comp_rule" model="ir.rule">
            <field name="name">Balance Sheet Report multi-company</field>
            <field name="model_id" ref="model_account_balance_sheet_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="profit_loss_report_comp_rule" model="ir.rule">
            <field name="name">Profit and Loss Report multi-company</field>
            <field name="model_id" ref="model_account_profit_loss_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="cash_flow_report_comp_rule" model="ir.rule">
            <field name="name">Cash Flow Report multi-company</field>
            <field name="model_id" ref="model_account_cash_flow_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="general_ledger_report_comp_rule" model="ir.rule">
            <field name="name">General Ledger Report multi-company</field>
            <field name="model_id" ref="model_account_general_ledger_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="trial_balance_report_comp_rule" model="ir.rule">
            <field name="name">Trial Balance Report multi-company</field>
            <field name="model_id" ref="model_account_trial_balance_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="aged_partner_balance_report_comp_rule" model="ir.rule">
            <field name="name">Aged Partner Balance Report multi-company</field>
            <field name="model_id" ref="model_account_aged_partner_balance_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
