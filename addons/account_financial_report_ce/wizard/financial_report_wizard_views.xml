    Financial Report Wizard Views
    Unified wizard for generating all financial reports
-->
<odoo>
    <!-- Financial Report Wizard Form View -->
    <record id="view_financial_report_wizard_form" model="ir.ui.view">
        <field name="name">account.financial.report.wizard.form</field>
        <field name="model">account.financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Financial Reports">
                <group>
                    <group string="Report Selection">
                        <field name="report_type" widget="radio"/>
                    </group>
                    <group string="Company">
                        <field name="company_id" options="{'no_create': True}"/>
                    </group>
                </group>
                
                <group string="Period Selection">
                    <group>
                        <field name="date_from" 
                               invisible="report_type == 'balance_sheet'"
                               required="report_type != 'balance_sheet' and report_type != 'aged_partner_balance'"/>
                        <field name="date_to" 
                               invisible="report_type == 'aged_partner_balance'"
                               required="report_type != 'aged_partner_balance'"/>
                        <field name="date_at" 
                               invisible="report_type != 'aged_partner_balance'"
                               required="report_type == 'aged_partner_balance'"/>
                    </group>
                    <group>
                        <field name="target_move" widget="radio"/>
                    </group>
                </group>

                <group string="Comparison Period" invisible="not compare_period or report_type == 'general_ledger' or report_type == 'aged_partner_balance'">
                    <group>
                        <field name="compare_period"/>
                    </group>
                    <group invisible="not compare_period">
                        <field name="compare_date_from" 
                               invisible="report_type == 'balance_sheet'"
                               required="compare_period and report_type != 'balance_sheet'"/>
                        <field name="compare_date_to" 
                               required="compare_period"/>
                    </group>
                </group>

                <notebook>
                    <!-- Filters Tab -->
                    <page string="Filters" name="filters">
                        <group>
                            <group string="Account Filters" invisible="report_type == 'aged_partner_balance'">
                                <field name="account_ids" 
                                       widget="many2many_tags"
                                       options="{'no_create': True}"/>
                                <field name="journal_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       domain="[('company_id', '=', company_id)]"/>
                            </group>
                            <group string="Partner Filters">
                                <field name="partner_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"/>
                                <field name="partner_type"
                                       invisible="report_type != 'aged_partner_balance'"
                                       required="report_type == 'aged_partner_balance'"/>
                            </group>
                        </group>
                        <group>
                            <group string="Analytic Filters">
                                <field name="analytic_account_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       domain="[('company_id', 'in', [company_id, False])]"/>
                            </group>
                        </group>
                    </page>

                    <!-- Display Options Tab -->
                    <page string="Display Options" name="options">
                        <group>
                            <group string="General Options">
                                <field name="hide_account_at_0"
                                       invisible="report_type == 'aged_partner_balance'"/>
                                <field name="show_hierarchy"
                                       invisible="report_type not in ['trial_balance', 'balance_sheet', 'profit_loss']"/>
                                <field name="show_partner_details"
                                       invisible="report_type not in ['trial_balance', 'general_ledger']"/>
                            </group>
                            <group string="Report-Specific Options">
                                <field name="show_details"
                                       invisible="report_type != 'general_ledger'"/>
                                <field name="show_move_lines"
                                       invisible="report_type != 'aged_partner_balance'"/>
                                <field name="cash_flow_method"
                                       invisible="report_type != 'cash_flow'"
                                       required="report_type == 'cash_flow'"/>
                            </group>
                        </group>
                    </page>
                </notebook>

                <footer>
                    <button name="action_print_pdf" type="object" string="Print PDF" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel" class="btn-secondary"/>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_financial_report_wizard" model="ir.actions.act_window">
        <field name="name">Financial Reports</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_date_to': (context_today()).strftime('%Y-%m-%d'),
            'default_date_from': (context_today().replace(day=1)).strftime('%Y-%m-%d'),
        }</field>
    </record>

    <!-- Quick Access Actions for Individual Reports -->
    <record id="action_balance_sheet_wizard" model="ir.actions.act_window">
        <field name="name">Balance Sheet</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_report_type': 'balance_sheet',
            'default_date_to': (context_today()).strftime('%Y-%m-%d'),
        }</field>
    </record>

    <record id="action_profit_loss_wizard" model="ir.actions.act_window">
        <field name="name">Profit and Loss</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_report_type': 'profit_loss',
            'default_date_to': (context_today()).strftime('%Y-%m-%d'),
            'default_date_from': (context_today().replace(day=1)).strftime('%Y-%m-%d'),
        }</field>
    </record>

    <record id="action_cash_flow_wizard" model="ir.actions.act_window">
        <field name="name">Cash Flow Statement</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_report_type': 'cash_flow',
            'default_date_to': (context_today()).strftime('%Y-%m-%d'),
            'default_date_from': (context_today().replace(day=1)).strftime('%Y-%m-%d'),
        }</field>
    </record>

    <record id="action_general_ledger_wizard" model="ir.actions.act_window">
        <field name="name">General Ledger</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_report_type': 'general_ledger',
            'default_date_to': (context_today()).strftime('%Y-%m-%d'),
            'default_date_from': (context_today().replace(day=1)).strftime('%Y-%m-%d'),
        }</field>
    </record>

    <record id="action_trial_balance_wizard" model="ir.actions.act_window">
        <field name="name">Trial Balance</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_report_type': 'trial_balance',
            'default_date_to': (context_today()).strftime('%Y-%m-%d'),
        }</field>
    </record>

    <record id="action_aged_receivable_wizard" model="ir.actions.act_window">
        <field name="name">Aged Receivable</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_report_type': 'aged_partner_balance',
            'default_partner_type': 'customer',
            'default_date_at': (context_today()).strftime('%Y-%m-%d'),
        }</field>
    </record>

    <record id="action_aged_payable_wizard" model="ir.actions.act_window">
        <field name="name">Aged Payable</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_report_type': 'aged_partner_balance',
            'default_partner_type': 'supplier',
            'default_date_at': (context_today()).strftime('%Y-%m-%d'),
        }</field>
    </record>

</odoo>
