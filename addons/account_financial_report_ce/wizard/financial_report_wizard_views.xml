    Financial Report Wizard Views
    Unified wizard for generating all financial reports:
      Balance Sheet (FR-001), Profit and Loss (FR-002),
      Cash Flow Statement (FR-003), General Ledger (FR-004),
      Trial Balance (FR-005), Aged Receivables/Payables (FR-006)

    Model: account.financial.report.wizard (TransientModel)

    Corrections applied to original scaffold:
      Model name corrected to 'account.financial.report.wizard' throughout.
      Removed non-existent 'date_at' field; use 'date_to' as "As of Date".
      Renamed fields to match Python model: enable_comparison,
        comparison_date_from, comparison_date_to, hide_zero_balance.
      Fixed all visibility/required conditions to use correct selection keys
        (aged_receivable / aged_payable, not aged_partner_balance).
      Moved enable_comparison checkbox to Period Selection for accessibility.
      Updated action_preview button to action_generate_report.
      Corrected all window action res_model and context defaults.
-->
<odoo>

    <!-- Financial Report Wizard Form View -->
    <record id="view_financial_report_wizard_form" model="ir.ui.view">
        <field name="name">financial.report.wizard.form</field>
        <!-- Corrected model to match Python _name -->
        <field name="model">account.financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Financial Reports">

                <!-- Report Type and Company Selection -->
                <group>
                    <group string="Report Selection">
                        <field name="report_type" widget="radio"/>
                    </group>
                    <group string="Company">
                        <field name="company_id" options="{'no_create': True}"/>
                    </group>
                </group>

                <!-- Period Selection:
                     date_from hidden for structural/aged reports,
                     date_to always visible as "As of Date" or end date,
                     enable_comparison placed here for user accessibility -->
                <group string="Period Selection">
                    <group>
                        <!-- date_from: visible only for period reports (P and L, Cash Flow, GL) -->
                        <field name="date_from"
                               invisible="report_type in ('balance_sheet', 'trial_balance', 'aged_receivable', 'aged_payable')"
                               required="report_type in ('profit_loss', 'cash_flow', 'general_ledger')"/>
                        <!-- date_to: always visible, replaces removed date_at field -->
                        <field name="date_to" required="1"/>
                        <!-- Renamed from compare_period to enable_comparison;
                             hidden for GL and aged types which do not support comparison -->
                        <field name="enable_comparison"
                               invisible="report_type in ('general_ledger', 'aged_receivable', 'aged_payable')"/>
                    </group>
                    <group>
                        <field name="target_move" widget="radio"/>
                    </group>
                </group>

                <!-- Comparison Period Dates:
                     visible only when enable_comparison is True and
                     the report type supports comparison -->
                <group string="Comparison Period"
                       invisible="not enable_comparison or report_type in ('general_ledger', 'aged_receivable', 'aged_payable')">
                    <group>
                        <!-- Renamed from compare_date_from;
                             hidden for structural reports that use single as-of date -->
                        <field name="comparison_date_from"
                               invisible="report_type in ('balance_sheet', 'trial_balance')"
                               required="enable_comparison and report_type not in ('balance_sheet', 'trial_balance')"/>
                        <!-- Renamed from compare_date_to -->
                        <field name="comparison_date_to"
                               required="enable_comparison"/>
                    </group>
                </group>

                <!-- Filters and Display Options -->
                <notebook>

                    <!-- Filters Tab -->
                    <page string="Filters" name="filters">
                        <group>
                            <!-- Account and Journal Filters: hidden for aged report types -->
                            <group string="Account Filters"
                                   invisible="report_type in ('aged_receivable', 'aged_payable')">
                                <field name="account_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       domain="[('company_ids', 'in', company_id)]"/>
                                <field name="journal_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       domain="[('company_id', '=', company_id)]"/>
                            </group>
                            <!-- Partner Filters: partner_type only for aged reports -->
                            <group string="Partner Filters">
                                <field name="partner_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"/>
                                <field name="partner_type"
                                       invisible="report_type not in ('aged_receivable', 'aged_payable')"
                                       required="report_type in ('aged_receivable', 'aged_payable')"/>
                            </group>
                        </group>
                        <group>
                            <!-- Analytic Filters: available for all report types -->
                            <group string="Analytic Filters">
                                <field name="analytic_account_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       domain="[('company_id', 'in', [company_id, False])]"/>
                            </group>
                        </group>
                    </page>

                    <!-- Display Options Tab:
                         Renamed hide_account_at_0 to hide_zero_balance;
                         fixed aged type visibility keys -->
                    <page string="Display Options" name="options">
                        <group>
                            <group string="General Options">
                                <!-- Renamed from hide_account_at_0 -->
                                <field name="hide_zero_balance"
                                       invisible="report_type in ('aged_receivable', 'aged_payable')"/>
                                <field name="show_hierarchy"
                                       invisible="report_type not in ('trial_balance', 'balance_sheet', 'profit_loss')"/>
                                <field name="show_partner_details"
                                       invisible="report_type not in ('trial_balance', 'general_ledger')"/>
                            </group>
                            <group string="Report-Specific Options">
                                <field name="show_details"
                                       invisible="report_type != 'general_ledger'"/>
                                <!-- Fixed visibility: aged_receivable/aged_payable instead of aged_partner_balance -->
                                <field name="show_move_lines"
                                       invisible="report_type not in ('aged_receivable', 'aged_payable')"/>
                                <field name="cash_flow_method"
                                       invisible="report_type != 'cash_flow'"
                                       required="report_type == 'cash_flow'"/>
                            </group>
                        </group>
                        <!-- Aging Buckets (Days):
                             Configurable overdue-tier thresholds for Aged
                             Receivable / Aged Payable reports only.  The
                             group is completely hidden for other report
                             types so the wizard UI remains uncluttered.
                             Defaults match industry-standard 30/60/90/120-
                             day tiers, which are passed through to the
                             account.aged.partner.balance.report model. -->
                        <group string="Aging Buckets (Days)"
                               invisible="report_type not in ('aged_receivable', 'aged_payable')">
                            <group>
                                <field name="bucket_1_days"/>
                                <field name="bucket_2_days"/>
                            </group>
                            <group>
                                <field name="bucket_3_days"/>
                                <field name="bucket_4_days"/>
                            </group>
                        </group>
                    </page>

                </notebook>

                <!-- Footer: replaced action_preview with action_generate_report -->
                <footer>
                    <button name="action_print_pdf"
                            type="object"
                            string="Print PDF"
                            class="btn-primary"/>
                    <button name="action_export_xlsx"
                            type="object"
                            string="Export Excel"
                            class="btn-secondary"/>
                    <button name="action_generate_report"
                            type="object"
                            string="Preview"
                            class="btn-secondary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

    <!-- Generic Financial Reports Wizard Action:
         All res_model fields corrected to account.financial.report.wizard -->
    <record id="action_financial_report_wizard" model="ir.actions.act_window">
        <field name="name">Financial Reports</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <!-- Quick Access: Balance Sheet -->
    <record id="action_balance_sheet_wizard" model="ir.actions.act_window">
        <field name="name">Balance Sheet</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'balance_sheet'}</field>
    </record>

    <!-- Quick Access: Profit and Loss -->
    <record id="action_profit_loss_wizard" model="ir.actions.act_window">
        <field name="name">Profit and Loss</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'profit_loss'}</field>
    </record>

    <!-- Quick Access: Cash Flow Statement -->
    <record id="action_cash_flow_wizard" model="ir.actions.act_window">
        <field name="name">Cash Flow Statement</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'cash_flow'}</field>
    </record>

    <!-- Quick Access: General Ledger -->
    <record id="action_general_ledger_wizard" model="ir.actions.act_window">
        <field name="name">General Ledger</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'general_ledger'}</field>
    </record>

    <!-- Quick Access: Trial Balance -->
    <record id="action_trial_balance_wizard" model="ir.actions.act_window">
        <field name="name">Trial Balance</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'trial_balance'}</field>
    </record>

    <!-- Quick Access: Aged Receivable
         Changed report_type from 'aged_partner_balance' to 'aged_receivable';
         removed default_partner_type; replaced default_date_at with default_date_to -->
    <record id="action_aged_receivable_wizard" model="ir.actions.act_window">
        <field name="name">Aged Receivable</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'aged_receivable'}</field>
    </record>

    <!-- Quick Access: Aged Payable
         Changed report_type from 'aged_partner_balance' to 'aged_payable';
         removed default_partner_type; replaced default_date_at with default_date_to -->
    <record id="action_aged_payable_wizard" model="ir.actions.act_window">
        <field name="name">Aged Payable</field>
        <field name="res_model">account.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'aged_payable'}</field>
    </record>

</odoo>
