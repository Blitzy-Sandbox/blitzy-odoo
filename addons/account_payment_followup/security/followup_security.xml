<odoo>
    <data noupdate="1">

        <!-- =================================================================
             Multi-Company Record Rules
             =================================================================
             These ir.rule records enforce row-level security so that users
             only see records belonging to companies they have access to
             (via the multi-company selector). The `company_ids` context
             variable is populated by Odoo at query time with the current
             user's allowed company IDs.

             All rules are declared `global=True` so they apply to ALL
             groups including admin — multi-company isolation must NOT be
             bypassable by group membership.
             ================================================================= -->

        <!-- Rule 1: account.followup.level (PF-001)
             Allows NULL company_id (global templates) OR records matching
             the user's current company context. This enables deployments
             to configure company-agnostic follow-up ladders that apply
             across all companies. -->
        <record id="account_followup_level_company_rule" model="ir.rule">
            <field name="name">Follow-up Level: multi-company</field>
            <field name="model_id" ref="model_account_followup_level"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Rule 2: account.followup.line (PF-005)
             Denormalized per-partner aging summary. Always tied to a
             specific company (no global records). -->
        <record id="account_followup_line_company_rule" model="ir.rule">
            <field name="name">Follow-up Line: multi-company</field>
            <field name="model_id" ref="model_account_followup_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Rule 3: account.followup.history (PF-004)
             Immutable audit trail of follow-up actions. Always tied to a
             specific company (ties to invoices/partners which are
             company-scoped). -->
        <record id="account_followup_history_company_rule" model="ir.rule">
            <field name="name">Follow-up History: multi-company</field>
            <field name="model_id" ref="model_account_followup_history"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
