<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Carbon Theme Toggle: Light / Dark Mode Button
        ================================================

        OWL template for the CarbonThemeToggle component that renders
        a single HeaderGlobalAction button inside the Carbon Header
        utility area (right section).

        Behaviour:
          Light mode active (isDarkMode = false):
              Shows a moon icon (Carbon "asleep" glyph).
              aria-label = "Switch to dark mode"
              Clicking switches to Carbon G90 dark theme.

          Dark mode active (isDarkMode = true):
              Shows a sun icon (Carbon "awake" glyph).
              aria-label = "Switch to light mode"
              Clicking switches to Carbon White light theme.

        The companion JS component (carbon_theme_toggle.js) handles:
          Reading the initial color_scheme cookie / localStorage
          Toggling Carbon theme classes on document.documentElement
          Persisting the preference via cookie and localStorage
          Triggering a page reload for full CSS bundle swap

        Carbon Design Token Compliance:
          All CSS classes use the Carbon v11 "cds" prefix.
          No hardcoded colors, pixel values, or font declarations.
          Button follows Carbon UI Shell HeaderGlobalAction anatomy
            (48 px height, icon centered, focus ring on :focus-visible).

        Accessibility (WCAG 2.1 AA):
          button is natively keyboard-focusable.
          aria-label changes dynamically to describe the pending action.
          aria-pressed reflects the current dark-mode boolean.
          title provides a tooltip for sighted mouse users.
          SVG icons carry aria-hidden="true" (decorative).
          focusable="false" on SVGs prevents double tab-stop.

        Integration:
          Placed inside CarbonHeader's "cds header global" div
          as CarbonThemeToggle (see carbon_header.xml).
    -->
    <t t-name="carbon_ui.CarbonThemeToggle">
        <button
            t-att-class="'cds--header__action cds--header__action--theme-toggle'
                + (state.isDarkMode ? ' cds--header__action--active' : '')"
            t-att-aria-label="state.isDarkMode
                ? 'Switch to light mode'
                : 'Switch to dark mode'"
            t-att-aria-pressed="state.isDarkMode ? 'true' : 'false'"
            t-att-title="state.isDarkMode
                ? 'Switch to light mode'
                : 'Switch to dark mode'"
            t-on-click="toggleTheme"
            type="button">

            <!--
                Moon icon: shown when light mode is active.
                Source: @carbon/icons v11, asleep.svg (16 px).
                Rendered at 20x20 display size to match other header
                action icons (hamburger, apps switcher).
                fill="currentColor" inherits the header text color
                from the Carbon text-secondary token.
            -->
            <svg t-if="!state.isDarkMode"
                 focusable="false"
                 preserveAspectRatio="xMidYMid meet"
                 xmlns="http://www.w3.org/2000/svg"
                 fill="currentColor"
                 width="20"
                 height="20"
                 viewBox="0 0 16 16"
                 aria-hidden="true"
                 class="cds--header__action__icon">
                <path d="M8,1L8,1C4.1,1.6,1.5,5.3,2.1,9.1c0.6,3.3,3.4,5.8,6.8,5.9
                         c0.1,0,0.2,0,0.3,0c2.3,0,4.4-1.1,5.8-3c0.2-0.2,0.1-0.6-0.1-0.7
                         c-0.1-0.1-0.2-0.1-0.3-0.1c-3.9-0.3-6.7-3.8-6.4-7.6
                         C8.3,3,8.4,2.4,8.6,1.8c0.1-0.3,0-0.6-0.3-0.7C8.1,1,8.1,1,8,1z"/>
            </svg>

            <!--
                Sun icon: shown when dark mode is active.
                Source: @carbon/icons v11, awake.svg (16 px).
                Rendered at 20x20 display size to match other header
                action icons.
                fill="currentColor" inherits the header text color.
            -->
            <svg t-if="state.isDarkMode"
                 focusable="false"
                 preserveAspectRatio="xMidYMid meet"
                 xmlns="http://www.w3.org/2000/svg"
                 fill="currentColor"
                 width="20"
                 height="20"
                 viewBox="0 0 16 16"
                 aria-hidden="true"
                 class="cds--header__action__icon">
                <path d="M7.5 1H8.5V3.5H7.5z"/>
                <path d="M10.8 3.4H13.3V4.4H10.8z"
                      transform="rotate(-45 12.074 3.922)"/>
                <path d="M12.5 7.5H15V8.5H12.5z"/>
                <path d="M11.6 10.8H12.6V13.3H11.6z"
                      transform="rotate(-45 12.077 12.075)"/>
                <path d="M7.5 12.5H8.5V15H7.5z"/>
                <path d="M2.7 11.6H5.2V12.6H2.7z"
                      transform="rotate(-45 3.929 12.078)"/>
                <path d="M1 7.5H3.5V8.5H1z"/>
                <path d="M3.4 2.7H4.4V5.2H3.4z"
                      transform="rotate(-45 3.926 3.925)"/>
                <path d="M8,6c1.1,0,2,0.9,2,2s-0.9,2-2,2S6,9.1,6,8S6.9,6,8,6
                         M8,5C6.3,5,5,6.3,5,8s1.3,3,3,3s3-1.3,3-3S9.7,5,8,5z"/>
            </svg>

        </button>
    </t>

</templates>
