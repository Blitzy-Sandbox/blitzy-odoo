 OR date_table.date <= emp_skill_level.valid_to)\n            ORDER BY date_table.date, emp_skill_level.employee_id, emp_skill_level.skill_id, emp_skill_level.valid_from DESC\n        )\n        \"\"\" % (self._table, ))\n"
